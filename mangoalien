-- ---------- GIẢM LAG (4 mức: Nhẹ → Cực mạnh) ----------
S.lagLevel = math.clamp(tonumber(S.lagLevel) or 2, 1, 4)

local Lag = {bk = setmetatable({}, {__mode = "k"}), level = 0, tok = 0, conns = {}}
do
	local LevelName = {"Nhẹ", "Vừa", "Mạnh", "Cực mạnh"}
	local PARTICLE = {ParticleEmitter = true, Trail = true, Beam = true, Smoke = true, Fire = true, Sparkles = true}
	local LIGHT    = {PointLight = true, SpotLight = true, SurfaceLight = true}
	local POST     = {BlurEffect = true, BloomEffect = true, SunRaysEffect = true, DepthOfFieldEffect = true}

	local function setp(inst, prop, val)
		local ok, old = pcall(function() return inst[prop] end)
		if not ok or old == val then return end
		local b = Lag.bk[inst]
		if not b then b = {} Lag.bk[inst] = b end
		if b[prop] == nil then b[prop] = old end
		pcall(function() inst[prop] = val end)
	end

	function Lag.applyInst(inst, lv)
		if inst:IsA("Terrain") then return end
		if inst:IsA("BasePart") then
			setp(inst, "CastShadow", false)
			if lv >= 3 then
				setp(inst, "Material", Enum.Material.SmoothPlastic)
				setp(inst, "Reflectance", 0)
			end
			if lv >= 4 then
				if inst:IsA("MeshPart") then setp(inst, "RenderFidelity", Enum.RenderFidelity.Performance) end
				local acc = inst:FindFirstAncestorOfClass("Accessory")
				if acc then
					local ch = acc:FindFirstAncestorOfClass("Model")
					if ch and ch ~= getChar() and Players:GetPlayerFromCharacter(ch) then
						setp(inst, "Transparency", 1)
					end
				end
			end
			return
		end
		local cn = inst.ClassName
		if POST[cn] then setp(inst, "Enabled", false) return end
		if lv >= 2 and PARTICLE[cn] then setp(inst, "Enabled", false) return end
		if lv >= 2 and cn == "Explosion" then setp(inst, "Visible", false) return end
		if lv >= 3 and LIGHT[cn] then setp(inst, "Enabled", false) return end
		if lv >= 3 and (cn == "Decal" or cn == "Texture") then setp(inst, "Transparency", 1) return end
		if lv >= 3 and cn == "Atmosphere" then setp(inst, "Density", 0) setp(inst, "Haze", 0) return end
		if lv >= 4 and cn == "ColorCorrectionEffect" then setp(inst, "Enabled", false) return end
	end

	function Lag.applyGlobal(lv)
		setp(Lighting, "GlobalShadows", false)
		if lv >= 3 then
			setp(Lighting, "EnvironmentDiffuseScale", 0)
			setp(Lighting, "EnvironmentSpecularScale", 0)
		end
		if lv >= 4 then setp(Lighting, "ShadowSoftness", 0) end

		local t = workspace:FindFirstChildOfClass("Terrain")
		if t then
			setp(t, "WaterWaveSize", 0)
			setp(t, "WaterWaveSpeed", 0)
			setp(t, "WaterReflectance", 0)
			if lv >= 2 and sethiddenproperty then
				pcall(function()
					if not Lag.decoSet then
						Lag.deco = gethiddenproperty and gethiddenproperty(t, "Decoration")
						Lag.decoSet = true
					end
					sethiddenproperty(t, "Decoration", false)
				end)
			end
		end

		if lv >= 2 then
			pcall(function()
				local r = settings().Rendering
				if Lag.q == nil then Lag.q = r.QualityLevel end
				r.QualityLevel = (lv >= 4 and Enum.QualityLevel.Level01)
					or (lv >= 3 and Enum.QualityLevel.Level03) or Enum.QualityLevel.Level05
			end)
		end
	end

	function Lag.restore()
		Lag.tok = Lag.tok + 1
		for _, c in ipairs(Lag.conns) do pcall(function() c:Disconnect() end) end
		Lag.conns = {}
		for inst, props in pairs(Lag.bk) do
			for prop, v in pairs(props) do pcall(function() inst[prop] = v end) end
		end
		Lag.bk = setmetatable({}, {__mode = "k"})
		pcall(function()
			if Lag.q ~= nil then settings().Rendering.QualityLevel = Lag.q Lag.q = nil end
		end)
		pcall(function()
			if Lag.decoSet and sethiddenproperty then
				sethiddenproperty(workspace:FindFirstChildOfClass("Terrain"), "Decoration", Lag.deco ~= false)
			end
		end)
		Lag.decoSet = false
		Lag.level = 0
	end

	function Lag.apply(lv)
		Lag.restore()
		Lag.level = lv
		local tok = Lag.tok
		Lag.applyGlobal(lv)

		for _, root in ipairs({workspace, Lighting}) do
			Lag.conns[#Lag.conns + 1] = root.DescendantAdded:Connect(function(d)
				if Lag.tok == tok then pcall(Lag.applyInst, d, lv) end
			end)
		end

		task.spawn(function()
			local n = 0
			for _, root in ipairs({Lighting, workspace}) do
				for _, d in ipairs(root:GetDescendants()) do
					if Lag.tok ~= tok then return end
					pcall(Lag.applyInst, d, lv)
					n = n + 1
					if n % 1500 == 0 then RunService.Heartbeat:Wait() end
				end
			end
			if Lag.tok == tok then toast("Giảm lag xong • mức " .. lv .. " (" .. LevelName[lv] .. ")") end
		end)
	end

	function Lag.on()
		Lag.apply(S.lagLevel)
		startLoop("lagwatch", function()
			if Lag.level ~= 0 and Lag.level ~= S.lagLevel then Lag.apply(S.lagLevel) end
		end, function() return 0.4 end)
	end
	function Lag.off()
		stopLoop("lagwatch")
		Lag.restore()
		toast("Đã tắt giảm lag (khôi phục đồ hoạ)")
	end
end

-- ---------- XE BAY (Vehicle Fly) ----------
local VF = {conn = nil, nc = nil, anchor = nil, model = nil, parts = {}, scan = 0, touched = {}}
do
	local function findAnchor()
		local hum, root = getHum(), getRoot()
		local seat = hum and hum.SeatPart
		if seat then return seat end
		local c = getChar()
		if root and c then
			local ar = root.AssemblyRootPart
			if ar and ar ~= root and not ar:IsDescendantOf(c) then return ar end
		end
		return nil
	end

	local function pickModel(anchor)
		local m = anchor:FindFirstAncestorOfClass("Model")
		if not m or m == workspace then return nil end
		local top = m
		while top.Parent and top.Parent ~= workspace and top.Parent:IsA("Model") do top = top.Parent end
		if #top:GetDescendants() > 2500 then return m end
		return top
	end

	local function collect()
		local list = {}
		if VF.model then
			for _, d in ipairs(VF.model:GetDescendants()) do
				if d:IsA("BasePart") then list[#list + 1] = d end
			end
		elseif VF.anchor then
			local ok, parts = pcall(function() return VF.anchor:GetConnectedParts(true) end)
			list = ok and parts or {VF.anchor}
		end
		VF.parts = list
		VF.scan = os.clock()
	end

	local function restoreCollide()
		for p in pairs(VF.touched) do
			if p.Parent then p.CanCollide = true end
		end
		VF.touched = {}
	end

	function VF.stop()
		if VF.conn then VF.conn:Disconnect() VF.conn = nil end
		if VF.nc then VF.nc:Disconnect() VF.nc = nil end
		VF.anchor, VF.model, VF.parts = nil, nil, {}
		restoreCollide()
	end

	function VF.start()
		VF.stop()
		if not findAnchor() then toast("Hãy ngồi vào xe (đã bật, sẽ tự chạy khi ngồi)") end

		VF.conn = RunService.Heartbeat:Connect(function(dt)
			local anchor = findAnchor()
			if not anchor then VF.anchor, VF.model, VF.parts = nil, nil, {} return end
			if anchor ~= VF.anchor then
				VF.anchor = anchor
				VF.model = pickModel(anchor)
				collect()
			elseif os.clock() - VF.scan > 1.5 then
				collect()
			end

			local cam = workspace.CurrentCamera
			local hum = getHum()
			local steer = State.vflyCam
			local d = Vector3.zero
			local turn = 0
			if not UIS:GetFocusedTextBox() then
				if UIS:IsKeyDown(Enum.KeyCode.W) then d += cam.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.S) then d -= cam.CFrame.LookVector end
				if steer then
					if UIS:IsKeyDown(Enum.KeyCode.A) then turn += 1 end
					if UIS:IsKeyDown(Enum.KeyCode.D) then turn -= 1 end
				else
					if UIS:IsKeyDown(Enum.KeyCode.A) then d -= cam.CFrame.RightVector end
					if UIS:IsKeyDown(Enum.KeyCode.D) then d += cam.CFrame.RightVector end
				end
				if UIS:IsKeyDown(Enum.KeyCode.Space) then d += Vector3.yAxis end
				if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then d -= Vector3.yAxis end
			end
			if d.Magnitude == 0 and turn == 0 and hum and hum.MoveDirection.Magnitude > 0 then
				d = hum.MoveDirection
			end
			if d.Magnitude > 0 then d = d.Unit end

			local cf = VF.model and VF.model:GetPivot() or anchor.CFrame
			local newcf = cf
			if turn ~= 0 then
				newcf = CFrame.new(cf.Position) * CFrame.Angles(0, turn * 2.2 * dt, 0) * cf.Rotation
			end
			newcf = newcf + d * S.vflySpeed * dt

			if VF.model then VF.model:PivotTo(newcf) else anchor.CFrame = newcf end

			for _, p in ipairs(VF.parts) do
				if p.Parent then
					p.AssemblyLinearVelocity = Vector3.zero
					p.AssemblyAngularVelocity = Vector3.zero
				end
			end
		end)

		VF.nc = RunService.Stepped:Connect(function()
			if not State.vflyNoclip then
				if next(VF.touched) then restoreCollide() end
				return
			end
			for _, p in ipairs(VF.parts) do
				if p.Parent and p.CanCollide then
					VF.touched[p] = true
					p.CanCollide = false
				end
			end
		end)
	end
end

-- ---------- AUTO LOOT (có chọn item) ----------
local Loot = {remote = nil, picked = 0, sent = setmetatable({}, {__mode = "k"}), home = nil, addConn = nil, stat = nil}
do
	local function lootPart(o)
		if o:IsA("BasePart") then return o end
		if o:IsA("Model") then
			return o:FindFirstChild("HumanoidRootPart") or o.PrimaryPart
				or o:FindFirstChildWhichIsA("BasePart", true)
		end
		return nil
	end

	-- chế độ 1: nhặt tất cả • chế độ 2: chỉ item có tên trong list (khớp đúng hoặc chứa)
	function Loot.wanted(name)
		if S.lootMode ~= 2 then return true end
		local l = name:lower()
		for _, s in ipairs(lootList) do
			local w = s:lower()
			if l == w or l:find(w, 1, true) then return true end
		end
		return false
	end

	function Loot.resolve()
		Loot.remote = nil
		local cur = ReplicatedStorage
		for _, n in ipairs({"Packages", "_Index", "sleitnick_knit@1.4.6", "knit",
			"Services", "ToolService", "RE", "Update"}) do
			cur = cur and cur:FindFirstChild(n)
		end
		if cur and cur:IsA("RemoteEvent") then Loot.remote = cur return end
		for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
			if d:IsA("RemoteEvent") and d.Name == "Update" and d.Parent and d.Parent.Name == "RE"
				and d.Parent.Parent and d.Parent.Parent.Name == "ToolService" then
				Loot.remote = d
				return
			end
		end
	end

	function Loot.tick()
		local root = getRoot()
		local folder = workspace:FindFirstChild("Items")
		if not root or not folder then return end
		if S.lootMode == 2 and #lootList == 0 then return end
		if not Loot.remote or not Loot.remote.Parent then Loot.resolve() end
		if not Loot.remote then return end
		local now = os.clock()
		local near, far, farD, busy = {}, nil, nil, false
		for _, item in ipairs(folder:GetChildren()) do
			if Loot.wanted(item.Name) then
				local part = lootPart(item)
				if part then
					local d = (root.Position - part.Position).Magnitude
					if d <= S.lootRadius then
						if not Loot.sent[item] or now - Loot.sent[item] > 1 then
							near[#near + 1] = {item = item, d = d}
						else
							busy = true
						end
					elseif State.lootTP and d <= S.lootTPRange and (not farD or d < farD) then
						far, farD = part, d
					end
				end
			end
		end
		table.sort(near, function(a, b) return a.d < b.d end)
		for i = 1, math.min(#near, S.lootMax) do
			local item = near[i].item
			Loot.sent[item] = now
			pcall(function() Loot.remote:FireServer({"Pickup", item}) end)
			Loot.picked = Loot.picked + 1
		end
		if Loot.stat then Loot.stat.Text = "Đã gửi lệnh nhặt: " .. Loot.picked .. " item" end
		if #near == 0 and not busy then
			if far then
				if not Loot.home then Loot.home = root.CFrame end
				teleportToCFrame(CFrame.new(far.Position + Vector3.new(0, 3, 0)))
			elseif Loot.home then
				if State.lootReturn then teleportToCFrame(Loot.home) end
				Loot.home = nil
			end
		end
	end

	-- nhặt ngay khi item vừa rơi ra (không chờ vòng quét)
	function Loot.instantOn(v)
		if Loot.addConn then Loot.addConn:Disconnect() Loot.addConn = nil end
		if not v then return end
		local folder = workspace:FindFirstChild("Items")
		if not folder then toast("Không thấy workspace.Items") return end
		Loot.addConn = track(folder.ChildAdded:Connect(function(item)
			task.wait(0.05)
			local root = getRoot()
			if not (State.autoLoot and root and item.Parent and Loot.remote and Loot.wanted(item.Name)) then return end
			local part = lootPart(item)
			if part and (root.Position - part.Position).Magnitude <= S.lootRadius then
				Loot.sent[item] = os.clock()
				Loot.picked = Loot.picked + 1
				pcall(function() Loot.remote:FireServer({"Pickup", item}) end)
			end
		end))
	end
end

-- ---------- ESP NGƯỜI CHƠI / NPC (viền Highlight xuyên tường) ----------
do
	local P = {objs = {}, npc = {}, npcConn = nil, folder = nil}
	Fx.PESP = P
	local function esc(t) return (tostring(t):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end

	local function hookNpc(h)
		if h:IsA("Humanoid") then
			local m = h.Parent
			if m and m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then P.npc[m] = h end
		end
	end

	function P.hooks()
		if State.pespNPC and not P.npcConn then
			P.npcConn = track(workspace.DescendantAdded:Connect(hookNpc))
			for i, d in ipairs(workspace:GetDescendants()) do
				if i % 3000 == 0 then RunService.Heartbeat:Wait() end
				hookNpc(d)
			end
		elseif not State.pespNPC and P.npcConn then
			P.npcConn:Disconnect()
			P.npcConn = nil
			P.npc = {}
		end
	end

	local function make(e)
		local hl = Instance.new("Highlight")
		hl.Adornee = e.m
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.FillTransparency = 0.65
		hl.OutlineTransparency = 0
		hl.Parent = P.folder
		local bb = Instance.new("BillboardGui")
		bb.Adornee = e.r
		bb.AlwaysOnTop = true
		bb.Size = UDim2.new(0, 150, 0, 34)
		bb.StudsOffset = Vector3.new(0, 3.4, 0)
		bb.Parent = P.folder
		local tl = Instance.new("TextLabel")
		tl.Size = UDim2.new(1, 0, 1, 0)
		tl.BackgroundTransparency = 1
		tl.RichText = true
		tl.Font = Enum.Font.GothamBold
		tl.TextSize = 12
		tl.TextColor3 = Color3.new(1, 1, 1)
		tl.TextStrokeTransparency = 0.45
		tl.Parent = bb
		return {hl = hl, bb = bb, tl = tl}
	end

	function P.tick()
		P.hooks()
		local root = getRoot()
		if not root then return end
		if not P.folder or not P.folder.Parent then
			P.folder = Instance.new("Folder")
			P.folder.Name = "AM_PESP"
			P.folder.Parent = ScreenGui.Parent
			P.objs = {}
		end
		local list = {}
		local me = getChar()
		local function consider(m, name, kind)
			local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
			local h = m:FindFirstChildOfClass("Humanoid")
			if r and h and h.Health > 0 and m ~= me then
				local d = (r.Position - root.Position).Magnitude
				if d <= S.pespRange then list[#list + 1] = {m = m, r = r, h = h, d = d, name = name, kind = kind} end
			end
		end
		if State.pespPlayers then
			for _, pl in ipairs(Players:GetPlayers()) do
				if pl ~= LocalPlayer and pl.Character then consider(pl.Character, pl.DisplayName, "P") end
			end
		end
		if State.pespNPC then
			for m in pairs(P.npc) do
				if m.Parent then consider(m, m.Name, "N") else P.npc[m] = nil end
			end
		end
		table.sort(list, function(a, b) return a.d < b.d end)
		local keep = {}
		for i = 1, math.min(#list, 30) do
			local e = list[i]
			local o = P.objs[e.m]
			if not o then
				o = make(e)
				P.objs[e.m] = o
			end
			local col = (e.kind == "P") and Color3.fromRGB(80, 220, 255) or Color3.fromRGB(255, 120, 80)
			o.hl.FillColor, o.hl.OutlineColor = col, col
			if State.pespNames then
				local hp, mx = math.floor(e.h.Health), math.max(math.floor(e.h.MaxHealth), 1)
				local ratio = hp / mx
				local hc = ratio > 0.6 and "#7CFC9A" or (ratio > 0.3 and "#FFD166" or "#FF6B6B")
				o.tl.Text = '<font color="#FFE27A">' .. esc(e.name) .. '</font>\n<font color="' .. hc .. '">'
					.. hp .. '/' .. mx .. '</font>  <font color="#C9CCE0">' .. math.floor(e.d) .. ' m</font>'
				o.bb.Enabled = true
			else
				o.bb.Enabled = false
			end
			keep[e.m] = true
		end
		for m, o in pairs(P.objs) do
			if not keep[m] then
				o.hl:Destroy()
				o.bb:Destroy()
				P.objs[m] = nil
			end
		end
	end

	function P.stop()
		stopLoop("pesp")
		for _, o in pairs(P.objs) do
			o.hl:Destroy()
			o.bb:Destroy()
		end
		P.objs = {}
		if P.folder then P.folder:Destroy() P.folder = nil end
		if P.npcConn then P.npcConn:Disconnect() P.npcConn = nil end
		P.npc = {}
	end

	function P.sync()
		if State.pespPlayers or State.pespNPC then
			if not Loops.pesp then startLoop("pesp", P.tick, function() return 0.2 end) end
		else
			P.stop()
		end
	end
end

-- ---------- TIỆN ÍCH MỚI: xem người chơi • đi bộ • anti void • auto đánh/click • nút E • camera • tự vào lại ----------
do
	local PathfindingService = svc("PathfindingService")
	local GuiService = svc("GuiService")
	local TeleportService = svc("TeleportService")

	-- XEM CAMERA NGƯỜI CHƠI
	local Spec = {target = nil}
	Fx.Spec = Spec
	function Spec.stop()
		Spec.target = nil
		stopLoop("spec")
		local cam, h = workspace.CurrentCamera, getHum()
		if cam and h then cam.CameraSubject = h end
	end
	function Spec.start(p)
		local c = p and p.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if not h then toast("Không xem được người chơi này") return end
		Spec.target = p
		workspace.CurrentCamera.CameraSubject = h
		toast("Đang xem: " .. p.DisplayName .. "  (bấm \"Dừng xem\" để thoát)")
		startLoop("spec", function()
			local pl = Spec.target
			if not pl then return end
			if not pl.Parent then Spec.stop() return end
			local hh = pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
			local cam = workspace.CurrentCamera
			if hh and cam.CameraSubject ~= hh then cam.CameraSubject = hh end
		end, function() return 0.5 end)
	end

	-- ĐI BỘ TỚI MỘT ĐIỂM (tìm đường, không teleport)
	local walkTok = 0
	function Fx.walkStop()
		walkTok = walkTok + 1
		local h, r = getHum(), getRoot()
		if h and r then h:MoveTo(r.Position) end
	end
	function Fx.walkTo(pos)
		local hum, root = getHum(), getRoot()
		if not hum or not root then return end
		walkTok = walkTok + 1
		local tok = walkTok
		task.spawn(function()
			local path = PathfindingService:CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true})
			local ok = pcall(function() path:ComputeAsync(root.Position, pos) end)
			if not ok or path.Status ~= Enum.PathStatus.Success then toast("Không tìm được đường đi") return end
			toast("Đang đi bộ tới điểm...")
			for _, wp in ipairs(path:GetWaypoints()) do
				if walkTok ~= tok then return end
				local h2 = getHum()
				if not h2 then return end
				if wp.Action == Enum.PathWaypointAction.Jump then h2.Jump = true end
				h2:MoveTo(wp.Position)
				h2.MoveToFinished:Wait()
			end
			if walkTok == tok then toast("Đã tới nơi") end
		end)
	end

	-- ANTI VOID (rơi khỏi map → về chỗ đứng vững gần nhất)
	local AV = {safe = nil}
	Fx.AV = AV
	function AV.tick()
		local root, hum = getRoot(), getHum()
		if not root or not hum then return end
		local limit = math.max(workspace.FallenPartsDestroyHeight, -3000) + 80
		local y = root.Position.Y
		if hum.FloorMaterial ~= Enum.Material.Air and y > limit + 100 then
			AV.safe = root.CFrame
		elseif y < limit and AV.safe then
			root.AssemblyLinearVelocity = Vector3.zero
			root.CFrame = AV.safe + Vector3.new(0, 3, 0)
			toast("Anti Void: đã về chỗ đứng an toàn")
		end
	end

	-- AUTO ATTACK (kích hoạt Tool đang cầm) + AUTO CLICK
	local AA = {}
	Fx.AA = AA
	function AA.tick()
		local char, hum = getChar(), getHum()
		if not char or not hum or hum.Health <= 0 then return end
		local q = trim(Fx.aaFilter or ""):lower()
		local function ok(t) return q == "" or t.Name:lower():find(q, 1, true) ~= nil end
		local tool
		for _, c in ipairs(char:GetChildren()) do
			if c:IsA("Tool") and ok(c) then tool = c break end
		end
		if not tool and State.aaEquip then
			local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
			if bp then
				for _, c in ipairs(bp:GetChildren()) do
					if c:IsA("Tool") and ok(c) then
						pcall(function() hum:EquipTool(c) end)
						tool = c
						break
					end
				end
			end
		end
		if tool then pcall(function() tool:Activate() end) end
	end

	local AC = {}
	Fx.AC = AC
	local function overGui()
		if not Main.Visible then return false end
		local p, sz = Main.AbsolutePosition, Main.AbsoluteSize
		return Mouse.X >= p.X and Mouse.X <= p.X + sz.X and Mouse.Y >= p.Y and Mouse.Y <= p.Y + sz.Y
	end
	function AC.tick()
		if UIS:GetFocusedTextBox() or overGui() then return end
		if mouse1click then
			pcall(mouse1click)
		else
			pcall(function()
				VirtualUser:CaptureController()
				VirtualUser:ClickButton1(Vector2.new(0, 0))
			end)
		end
	end

	-- NÚT E (ProximityPrompt): bấm không cần giữ + tự bấm trong tầm
	local PP = {set = setmetatable({}, {__mode = "k"}), bk = setmetatable({}, {__mode = "k"}),
		last = setmetatable({}, {__mode = "k"}), conn = nil}
	Fx.PP = PP
	local function ppPos(d)
		local par = d.Parent
		if not par then return nil end
		if par:IsA("BasePart") then return par.Position end
		if par:IsA("Attachment") then return par.WorldPosition end
		if par:IsA("Model") then return par:GetPivot().Position end
		return nil
	end
	function PP.restore()
		for d, h in pairs(PP.bk) do
			if d.Parent then pcall(function() d.HoldDuration = h end) end
		end
		PP.bk = setmetatable({}, {__mode = "k"})
	end
	function PP.tick()
		local root = getRoot()
		if not root then return end
		local q = trim(Fx.ppFilter or ""):lower()
		local now = os.clock()
		for d in pairs(PP.set) do
			if not d.Parent then
				PP.set[d] = nil
			else
				if State.ppInstant and d.HoldDuration ~= 0 then
					if PP.bk[d] == nil then PP.bk[d] = d.HoldDuration end
					d.HoldDuration = 0
				end
				if State.ppAuto and fireproximityprompt and d.Enabled and (not PP.last[d] or now - PP.last[d] > 0.5) then
					local pos = ppPos(d)
					if pos and (pos - root.Position).Magnitude <= S.ppRange then
						local hay = (d.ActionText .. " " .. d.ObjectText .. " " .. (d.Parent and d.Parent.Name or "")):lower()
						if q == "" or hay:find(q, 1, true) then
							PP.last[d] = now
							pcall(fireproximityprompt, d)
						end
					end
				end
			end
		end
	end
	function PP.sync()
		if State.ppInstant or State.ppAuto then
			if not PP.conn then
				local function add(d) if d:IsA("ProximityPrompt") then PP.set[d] = true end end
				PP.conn = track(workspace.DescendantAdded:Connect(add))
				task.spawn(function()
					for i, d in ipairs(workspace:GetDescendants()) do
						if i % 3000 == 0 then RunService.Heartbeat:Wait() end
						add(d)
					end
				end)
			end
			if not Loops.pp then startLoop("pp", PP.tick, function() return 0.25 end) end
		else
			stopLoop("pp")
			if PP.conn then PP.conn:Disconnect() PP.conn = nil end
			PP.set = setmetatable({}, {__mode = "k"})
		end
		if not State.ppInstant then PP.restore() end
	end

	-- Tìm nút E gần một điểm (không quét cả map, chỉ hỏi các vật quanh điểm đó)
	-- needEnabled: chỉ lấy nút đang bật • filter(d, dist) trả về điểm phạt (số nhỏ = ưu tiên) hoặc nil để bỏ qua nút đó
	function PP.around(center, r, needEnabled, filter)
		local parts = {}
		pcall(function()
			local op = OverlapParams.new()
			op.FilterType = Enum.RaycastFilterType.Exclude
			op.FilterDescendantsInstances = {getChar()}
			parts = workspace:GetPartBoundsInRadius(center, r, op)
		end)
		local best, bs
		local seen = {}
		local function try(d)
			if d and not seen[d] then
				seen[d] = true
				if needEnabled and not d.Enabled then return end
				local pos = ppPos(d)
				if pos then
					local dist = (pos - center).Magnitude
					if dist <= r then
						local pen = 0
						if filter then pen = filter(d, dist) end
						if pen then
							local s = dist + pen
							if not bs or s < bs then best, bs = d, s end
						end
					end
				end
			end
		end
		for _, part in ipairs(parts) do
			try(part:FindFirstChildOfClass("ProximityPrompt"))
			for _, ch in ipairs(part:GetChildren()) do
				if ch:IsA("Attachment") then try(ch:FindFirstChildOfClass("ProximityPrompt")) end
			end
			local m = part:FindFirstAncestorOfClass("Model")
			if m then try(m:FindFirstChildOfClass("ProximityPrompt")) end
		end
		return best
	end

	-- BẤM E THỦ CÔNG: bấm nút E gần nhất (bạn tự đặt phím); không quét cả map, chỉ hỏi các vật quanh bạn
	function PP.press(quiet)
		local root = getRoot()
		if not root then return false end
		local r = S.ppManual
		local best = PP.around(root.Position, r, true)
		if not best then
			if not quiet then toast("Không có nút E trong tầm " .. r .. " studs") end
			return false
		end
		if fireproximityprompt then
			pcall(fireproximityprompt, best)
		else
			pcall(function()
				best:InputHoldBegin()
				task.wait(math.max(best.HoldDuration, 0) + 0.05)
				best:InputHoldEnd()
			end)
		end
		if not quiet then
			toast("Đã bấm E: " .. ((best.ActionText ~= "" and best.ActionText) or (best.Parent and best.Parent.Name) or "?"))
		end
		return true
	end

	-- ĐIỂM NÚT E: lưu chỗ có nút E → đi xa vẫn bấm được
	-- Lưu: đường dẫn trong workspace + vị trí + chữ trên nút (chỉ số/chữ nên ghi được vào config, không giữ Instance).
	-- Bấm: tìm lại nút (cache → đường dẫn → quanh vị trí đã lưu) rồi bấm.
	--   Chế độ 1: bấm thẳng từ xa • Chế độ 2: TP tới nút → bấm → quay lại chỗ cũ (cho game có kiểm tra khoảng cách).
	local EP = {cache = setmetatable({}, {__mode = "k"}), busy = false, homeCF = nil,
		sel = math.max(1, math.floor(tonumber(Config.epSel) or 1))}
	Fx.EP = EP

	local function epPos(pt) return Vector3.new(pt.pos[1], pt.pos[2], pt.pos[3]) end

	local function cutText(s, n)
		local len = utf8.len(s)
		if not len then return (s:gsub("[\128-\255]", "?")):sub(1, n) end
		if len <= n then return s end
		return s:sub(1, utf8.offset(s, n + 1) - 1)
	end

	-- con thứ k có tên `name` của `parent` (phân biệt các vật trùng tên)
	local function nth(parent, name, k)
		local n = 0
		for _, ch in ipairs(parent:GetChildren()) do
			if ch.Name == name then
				n = n + 1
				if n == k then return ch end
			end
		end
		return nil
	end
	local function sibIndex(inst)
		local n = 0
		for _, ch in ipairs(inst.Parent:GetChildren()) do
			if ch.Name == inst.Name then
				n = n + 1
				if ch == inst then return n end
			end
		end
		return 1
	end
	local function pathOf(inst)
		local names, idx = {}, {}
		local a = inst
		while a and a ~= workspace do
			if not a.Parent then return nil end
			table.insert(names, 1, a.Name)
			table.insert(idx, 1, sibIndex(a))
			a = a.Parent
		end
		if a ~= workspace then return nil end
		return names, idx
	end
	local function pathKey(names, idx)
		return table.concat(names, "/") .. "|" .. (idx and table.concat(idx, ",") or "")
	end

	function EP.cur()
		if #epoints == 0 then return nil end
		if EP.sel < 1 or EP.sel > #epoints then EP.sel = 1 end
		return epoints[EP.sel]
	end

	function EP.select(i, quiet)
		if not epoints[i] then return end
		EP.sel = i
		Config.epSel = i
		saveConfig()
		if not quiet then toast("Đang chọn: " .. epoints[i].name) end
		if Fx.renderEP then Fx.renderEP() end
	end

	function EP.add(prompt, name)
		local pos = ppPos(prompt)
		if not pos then toast("Không đọc được vị trí của nút E này") return false end
		local names, idx = pathOf(prompt)
		if not names then toast("Nút E này nằm ngoài workspace") return false end
		local key = pathKey(names, idx)
		for i, pt in ipairs(epoints) do
			if pathKey(pt.path, pt.idx) == key then
				EP.select(i, true)
				toast("Nút E này đã có trong list: " .. pt.name .. " (đã chọn)")
				return false
			end
		end
		name = trim(name or "")
		if name == "" then
			local a, o = prompt.ActionText, prompt.ObjectText
			if a ~= "" and o ~= "" then name = o .. " - " .. a
			elseif a ~= "" then name = a
			elseif o ~= "" then name = o
			else name = (prompt.Parent and prompt.Parent.Name) or "Nút E" end
		end
		name = cutText(name, 28)
		local pt = {name = name, path = names, idx = idx, pos = {pos.X, pos.Y, pos.Z},
			action = prompt.ActionText, object = prompt.ObjectText}
		epoints[#epoints + 1] = pt
		EP.cache[pt] = prompt
		EP.sel = #epoints
		Config.epSel = EP.sel
		saveConfig()
		if Fx.renderEP then Fx.renderEP() end
		local root = getRoot()
		local d = root and math.floor((pos - root.Position).Magnitude) or 0
		toast("Đã lưu điểm E: " .. name .. "  (cách " .. d .. " m)")
		return true
	end

	function EP.remove(i)
		local pt = epoints[i]
		if not pt then return end
		table.remove(epoints, i)
		EP.cache[pt] = nil
		if EP.sel > i then EP.sel = EP.sel - 1 end
		if EP.sel > #epoints then EP.sel = math.max(#epoints, 1) end
		Config.epSel = EP.sel
		saveConfig()
		if Fx.renderEP then Fx.renderEP() end
	end

	-- Lưu nút E gần bạn nhất
	function EP.saveNear(name)
		local root = getRoot()
		if not root then return false end
		local p = PP.around(root.Position, 30, false)
		if not p then toast("Không có nút E nào trong 30 studs quanh bạn") return false end
		return EP.add(p, name)
	end
	-- Lưu nút E gần chỗ con trỏ đang trỏ (dùng với phím tắt: trỏ vào vật rồi bấm phím)
	function EP.saveMouse(name)
		local hit = Mouse.Hit
		if not hit then toast("Hãy trỏ chuột vào vật có nút E") return false end
		local p = PP.around(hit.Position, 12, false)
		if not p then toast("Không có nút E nào gần chỗ con trỏ (12 studs)") return false end
		return EP.add(p, name)
	end

	-- Tìm lại nút E của một điểm đã lưu (nil nếu chưa tải / đã bị xoá)
	function EP.resolve(pt)
		local c = EP.cache[pt]
		if c and c.Parent and c:IsDescendantOf(workspace) then return c end
		EP.cache[pt] = nil
		-- 1) theo đường dẫn đã lưu
		local cur = workspace
		for i, n in ipairs(pt.path) do
			cur = cur and nth(cur, n, (pt.idx and pt.idx[i]) or 1)
			if not cur then break end
		end
		if cur and cur:IsA("ProximityPrompt") and cur.ActionText == pt.action and cur.ObjectText == pt.object then
			EP.cache[pt] = cur
			return cur
		end
		-- 2) theo vị trí đã lưu: ưu tiên nút trùng chữ; nút khác chữ chỉ nhận nếu nằm sát (≤ 4 studs)
		local best = PP.around(epPos(pt), 15, false, function(d, dist)
			if d.ActionText == pt.action and d.ObjectText == pt.object then return 0 end
			if dist <= 4 then return 100 end
			return nil
		end)
		if best then EP.cache[pt] = best end
		return best
	end

	-- vị trí hiện tại của nút (nếu đang tải) hoặc vị trí đã lưu
	function EP.where(pt)
		local p = EP.cache[pt]
		if p and p.Parent then
			local pos = ppPos(p)
			if pos then return pos end
		end
		return epPos(pt)
	end

	function EP.tp(pt)
		teleportToCFrame(CFrame.new(EP.where(pt) + Vector3.new(0, 3, 0)))
		toast("TP tới điểm E: " .. pt.name)
	end

	-- bấm 1 lần: tạm bỏ giữ / giới hạn khoảng cách / line-of-sight (chỉ phía client) rồi trả lại như cũ
	local function fireE(prompt)
		local hold, dist, los = prompt.HoldDuration, prompt.MaxActivationDistance, prompt.RequiresLineOfSight
		pcall(function()
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = math.max(dist, 100000)
			prompt.RequiresLineOfSight = false
		end)
		local ok
		if fireproximityprompt then
			ok = pcall(fireproximityprompt, prompt)
		else
			ok = pcall(function()
				prompt:InputHoldBegin()
				task.wait(0.05)
				prompt:InputHoldEnd()
			end)
		end
		task.wait(0.05)
		pcall(function()
			prompt.HoldDuration = hold
			prompt.MaxActivationDistance = dist
			prompt.RequiresLineOfSight = los
		end)
		return ok
	end

	function EP.run(pt, quiet)
		local root = getRoot()
		if not root then return false end
		local home = root.CFrame
		local moved = false

		local function approach(pos)
			local keep = prevCF
			teleportToCFrame(CFrame.new(pos + Vector3.new(0, 3, 0)), true)
			prevCF = keep
			moved = true
			EP.homeCF = home
		end
		local function back(waitFirst)
			if not moved then return end
			if waitFirst then task.wait(S.epWait) end
			if getRoot() then
				local keep = prevCF
				teleportToCFrame(home, true)
				prevCF = keep
			end
			moved, EP.homeCF = false, nil
		end

		local prompt = EP.resolve(pt)
		local direct = (S.epMode ~= 2) and fireproximityprompt ~= nil
		if not prompt then
			-- chưa thấy nút (map chưa tải do StreamingEnabled) → bay tới chỗ đã lưu cho map tải ra, rồi thử lại
			approach(epPos(pt))
			local t0 = os.clock()
			repeat
				task.wait(0.15)
				prompt = EP.resolve(pt)
			until prompt or os.clock() - t0 > 3
		elseif not direct then
			approach(ppPos(prompt) or epPos(pt))
		end
		if not prompt then
			back(false)
			if not quiet then toast("Không thấy nút E ở điểm \"" .. pt.name .. "\" (đã bị xoá / đổi chỗ?)") end
			return false
		end
		if moved then task.wait(S.epWait) end -- cho server nhận vị trí mới trước khi bấm
		if not prompt.Enabled then
			back(false)
			if not quiet then toast("Nút E đang bị tắt: " .. pt.name) end
			return false
		end
		local ok = fireE(prompt)
		back(true)
		if not quiet then toast(ok and ("Đã bấm E: " .. pt.name) or ("Bấm E thất bại: " .. pt.name)) end
		return ok
	end

	function EP.press(pt, quiet)
		if not pt then
			if not quiet then toast("Chưa có điểm E nào — hãy lưu một điểm trước") end
			return false
		end
		if EP.busy then
			if not quiet then toast("Đang bấm điểm E khác, thử lại sau") end
			return false
		end
		EP.busy = true
		local ok, res = pcall(EP.run, pt, quiet)
		EP.busy = false
		if not ok then
			warn("[AlienMango] điểm E: " .. tostring(res))
			if EP.homeCF and getRoot() then
				local keep = prevCF
				teleportToCFrame(EP.homeCF, true)
				prevCF = keep
			end
			EP.homeCF = nil
			return false
		end
		return res and true or false
	end

	function EP.pressAll(quiet)
		if #epoints == 0 then
			if not quiet then toast("Chưa có điểm E nào") end
			return
		end
		local snap = {}
		for i, pt in ipairs(epoints) do snap[i] = pt end
		local n = 0
		for _, pt in ipairs(snap) do
			if EP.press(pt, true) then n = n + 1 end
			task.wait(0.1)
		end
		if not quiet then toast("Đã bấm " .. n .. "/" .. #snap .. " điểm E") end
	end

	-- CAMERA / THỜI GIAN
	local Cam = {}
	Fx.Cam = Cam
	function Cam.fov(v)
		if Cam.fovConn then Cam.fovConn:Disconnect() Cam.fovConn = nil end
		local cam = workspace.CurrentCamera
		if v then
			if Cam.fov0 == nil then Cam.fov0 = cam.FieldOfView end
			Cam.fovConn = track(RunService.RenderStepped:Connect(function()
				local c = workspace.CurrentCamera
				if c and c.FieldOfView ~= S.fov then c.FieldOfView = S.fov end
			end))
		elseif Cam.fov0 ~= nil then
			cam.FieldOfView = Cam.fov0
			Cam.fov0 = nil
		end
	end
	function Cam.zoom(v)
		stopLoop("zoom")
		if v then
			if not Cam.z0 then Cam.z0 = {LocalPlayer.CameraMaxZoomDistance, LocalPlayer.CameraMinZoomDistance} end
			startLoop("zoom", function()
				LocalPlayer.CameraMaxZoomDistance = S.zoomMax
				LocalPlayer.CameraMinZoomDistance = 0
			end, function() return 0.5 end)
		elseif Cam.z0 then
			LocalPlayer.CameraMaxZoomDistance = Cam.z0[1]
			LocalPlayer.CameraMinZoomDistance = Cam.z0[2]
			Cam.z0 = nil
		end
	end
	function Cam.clock(v)
		if Cam.clockConn then Cam.clockConn:Disconnect() Cam.clockConn = nil end
		if v then
			if Cam.c0 == nil then Cam.c0 = Lighting.ClockTime end
			Cam.clockConn = track(RunService.RenderStepped:Connect(function() Lighting.ClockTime = S.clock end))
		elseif Cam.c0 ~= nil then
			Lighting.ClockTime = Cam.c0
			Cam.c0 = nil
		end
	end

	-- TỰ VÀO LẠI KHI BỊ KICK / MẤT KẾT NỐI
	function Fx.autoRejoinOn(v)
		if Fx.arConn then Fx.arConn:Disconnect() Fx.arConn = nil end
		if not v then return end
		Fx.arConn = track(GuiService.ErrorMessageChanged:Connect(function(msg)
			if State.autoRejoin and msg and msg ~= "" then
				toast("Mất kết nối → đang vào lại game...")
				task.wait(3)
				pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
			end
		end))
	end
end

