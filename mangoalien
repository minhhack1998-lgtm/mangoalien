local Loops = {}
local function startLoop(id, body, getDelay)
	local token = {}
	Loops[id] = token
	task.spawn(function()
		while Loops[id] == token do
			local ok, err = pcall(body)
			if not ok then warn("[AlienMango] " .. id .. ": " .. tostring(err)) end
			task.wait(getDelay())
		end
	end)
end
local function stopLoop(id) Loops[id] = nil end

-- ---------- Teleport helpers ----------
local prevCF
local tpTok = 0
-- instant = true: luôn dịch chuyển tức thì (dùng cho thoát hiểm), bỏ qua chế độ TP mượt
local function teleportToCFrame(cf, instant)
	local root = getRoot()
	if not root then return end
	prevCF = root.CFrame
	tpTok = tpTok + 1
	if State.smoothTP and not instant then
		local tok = tpTok
		local start = root.CFrame
		local dist = (cf.Position - start.Position).Magnitude
		local dur = math.max(dist / math.max(S.tpSpeed, 1), 0.05)
		task.spawn(function()
			local t0 = os.clock()
			while tpTok == tok and root.Parent do
				local a = math.min((os.clock() - t0) / dur, 1)
				root.AssemblyLinearVelocity = Vector3.zero
				root.CFrame = start:Lerp(cf, a)
				if a >= 1 then break end
				RunService.Heartbeat:Wait()
			end
		end)
	else
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = cf
	end
end

local function teleportToMouse()
	if Mouse.Hit then teleportToCFrame(CFrame.new(Mouse.Hit.Position + Vector3.new(0, 3, 0))) end
end

-- ---------- Fly ----------
local flyBV, flyBG, flyConn, flyHum
local function stopFly()
	if flyConn then flyConn:Disconnect() flyConn = nil end
	if flyBV then flyBV:Destroy() flyBV = nil end
	if flyBG then flyBG:Destroy() flyBG = nil end
	if flyHum and flyHum.Parent and not State.ragdoll then flyHum.PlatformStand = false end
	flyHum = nil
end
local function startFly()
	local root, hum = getRoot(), getHum()
	if not root or not hum then toast("Không tìm thấy nhân vật") Toggles.fly.set(false) return end
	stopFly()
	flyHum = hum
	flyBV = new("BodyVelocity", {MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero}, root)
	flyBG = new("BodyGyro", {MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 1e4, CFrame = root.CFrame}, root)
	hum.PlatformStand = true
	flyConn = RunService.RenderStepped:Connect(function()
		local r = getRoot()
		if not r or not flyBV or flyBV.Parent ~= r then Toggles.fly.set(false) return end
		local cam = workspace.CurrentCamera
		local d = Vector3.zero
		if not UIS:GetFocusedTextBox() then
			if UIS:IsKeyDown(Enum.KeyCode.W) then d += cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.S) then d -= cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.A) then d -= cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.D) then d += cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.Space) then d += Vector3.yAxis end
			if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then d -= Vector3.yAxis end
		end
		if d.Magnitude == 0 and hum.MoveDirection.Magnitude > 0 then d = hum.MoveDirection end -- mobile
		if d.Magnitude > 0 then d = d.Unit end
		flyBV.Velocity = d * S.flySpeed
		flyBG.CFrame = cam.CFrame
	end)
end

