local Loops = {}
local function startLoop(id, body, getDelay)
	local token = {}
	Loops[id] = token
	task.spawn(function()
		while Loops[id] == token do
			local ok, err = pcall(body)
			if not ok then warn("[AlienMango] " .. id .. ": " .. tostring(err)) end
			task.wait(getDelay())
		end
	end)
end
