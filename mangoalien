	bindAccent(ind, "BackgroundColor3")
	local dot = new("Frame", {Size = UDim2.new(0, 7, 0, 7), Position = UDim2.new(1, -14, 0.5, -3), BorderSizePixel = 0,
		BackgroundTransparency = 1}, btn)
