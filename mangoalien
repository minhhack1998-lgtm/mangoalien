local function addToggle(page, id, label, cfg)
	cfg = cfg or {}
	local t = {id = id, persist = cfg.persist, opt = cfg.noKey}
	Toggles[id] = t
	State[id] = false
	if cfg.persist then
		local sv = Config.options[id]
		if sv == nil then sv = cfg.default or false end
		State[id] = sv and true or false
	end

	local row = card(page, 38, ord(page))
	local trk = new("Frame", {Size = UDim2.new(0, 36, 0, 20), Position = UDim2.new(0, 10, 0.5, -10),
		BackgroundColor3 = Theme.Off, BorderSizePixel = 0}, row)
	corner(trk, 10)
	t.trk = trk
	local knob = new("Frame", {Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(0, 3, 0.5, -7),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0}, trk)
	corner(knob, 7)

	local keyW = cfg.noKey and 0 or 68
	local hit = new("TextButton", {
		Size = UDim2.new(1, -(keyW + 6), 1, 0), BackgroundTransparency = 1, Text = label, TextColor3 = Theme.Text,
		Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, AutoButtonColor = false,
	}, row)
	new("UIPadding", {PaddingLeft = UDim.new(0, 56)}, hit)
	hover(row, Theme.Item, Theme.ItemHover)

	local function refresh()
		local on = State[id]
		tween(trk, {BackgroundColor3 = on and Theme.Accent or Theme.Off}, 0.15)
		tween(knob, {Position = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)}, 0.15)
		hit.TextColor3 = on and Color3.new(1, 1, 1) or Theme.Text
	end
	t.refresh = refresh
	accentHooks[#accentHooks + 1] = refresh

	function t.set(v)
		v = v and true or false
		if State[id] == v then return end
		State[id] = v
		refresh()
		if cfg.persist then Config.options[id] = v saveConfig() end
		if cfg.fn then cfg.fn(v) end
	end
	function t.toggle() t.set(not State[id]) end
	hit.MouseButton1Click:Connect(t.toggle)

	if not cfg.noKey then
		Binds[id] = {name = label, default = cfg.key, action = t.toggle}
		makeKeyBtn(row, id)
	end
	refresh()
	if cfg.persist and cfg.initCall and State[id] then pendingInit[#pendingInit + 1] = function() cfg.fn(true) end end
	return t
end

