-- ---------- Auto aim ----------
local AimParts = {"Head", "HumanoidRootPart"}
local npcList, npcConn, aimConn = {}, nil, nil
local function addNPC(h)
	if h:IsA("Humanoid") then
		local m = h.Parent
		if m and m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then npcList[h] = true end
	end
end
local function visibleTo(origin, part, model)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = {getChar()}
	rp.IgnoreWater = true
	local res = workspace:Raycast(origin, part.Position - origin, rp)
	return (not res) or res.Instance:IsDescendantOf(model)
end
local function stopAim()
	if aimConn then aimConn:Disconnect() aimConn = nil end
	if npcConn then npcConn:Disconnect() npcConn = nil end
	npcList = {}
end
local function startAim()
	stopAim()
	for _, d in ipairs(workspace:GetDescendants()) do addNPC(d) end
	npcConn = workspace.DescendantAdded:Connect(addNPC)
	aimConn = RunService.RenderStepped:Connect(function()
		local cam, root = workspace.CurrentCamera, getRoot()
		if not cam or not root then return end
		local center = cam.ViewportSize / 2
		local me = getChar()
		local pname = AimParts[S.aimPartIdx] or "Head"
		local best, bestScore
		for h in pairs(npcList) do
			local m = h.Parent
			if not m then
				npcList[h] = nil
			elseif h.Health > 0 and m ~= me then
				local part = m:FindFirstChild(pname) or m:FindFirstChild("HumanoidRootPart")
				if part and (part.Position - root.Position).Magnitude <= S.aimRange then
					local p, on = cam:WorldToViewportPoint(part.Position)
					if on then
						local score = (Vector2.new(p.X, p.Y) - center).Magnitude
						if score <= S.aimFov and (not best or score < bestScore)
							and (not State.aimWall or visibleTo(cam.CFrame.Position, part, m)) then
							best, bestScore = part, score
						end
					end
				end
			end
		end
		if best then
			local goal = CFrame.new(cam.CFrame.Position, best.Position)
			cam.CFrame = (S.aimSmooth >= 1) and goal or cam.CFrame:Lerp(goal, S.aimSmooth)
		end
	end)
end

-- ---------- Tìm item / ore ----------
local function resolveTarget(inst)
	if inst and (inst:IsA("Model") or inst:IsA("BasePart") or inst:IsA("Tool")) then return inst end
	return nil
end

local function getPos(inst)
	if inst:IsA("Model") then return inst:GetPivot().Position end
	if inst:IsA("Tool") then
		local h = inst:FindFirstChild("Handle")
		return h and h.Position
	end
	return inst.Position
end

local function findItems(name, partial)
	local wanted = name:lower()
	local char = getChar()
	local playerChars = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then playerChars[#playerChars + 1] = p.Character end
	end

	local function match(v)
		if v == nil then return false end
		local s = tostring(v):lower()
		if partial then return s:find(wanted, 1, true) ~= nil end
		return s == wanted
	end

	local found = {}
	local function add(inst)
		if not inst or inst == workspace then return end
		if char and inst:IsDescendantOf(char) then return end
		for _, c in ipairs(playerChars) do
			if inst == c or inst:IsDescendantOf(c) then return end
		end
		if inst:IsA("Model") and #inst:GetDescendants() > 300 then return end
		found[inst] = true
	end

	local deep = State.deepSearch
	local desc = workspace:GetDescendants()
	for i, d in ipairs(desc) do
		if i % 4000 == 0 then RunService.Heartbeat:Wait() end -- tránh đơ game
		if match(d.Name) then add(resolveTarget(d)) end
		if deep then
			if d:IsA("ValueBase") then
				local okv, v = pcall(function() return d.Value end)
				if okv and match(v) then add(resolveTarget(d.Parent)) end
			elseif d:IsA("TextLabel") or d:IsA("TextButton") then
				if match(d.Text) then
					add(d:FindFirstAncestorOfClass("Tool") or d:FindFirstAncestorOfClass("Model")
						or d:FindFirstAncestorWhichIsA("BasePart"))
				end
			elseif d:IsA("Model") or d:IsA("BasePart") or d:IsA("Tool") then
				for _, val in pairs(d:GetAttributes()) do
					if match(val) then add(d) break end
				end
			end
		end
	end

	local list = {}
	for inst in pairs(found) do
		local nested, anc = false, inst.Parent
		while anc and anc ~= workspace do
			if found[anc] then nested = true break end
			anc = anc.Parent
		end
		if not nested then list[#list + 1] = inst end
	end
	return list
end

local function searchItems(name)
	local list = findItems(name, false)
	if #list == 0 and #name >= 2 then list = findItems(name, true) end
	return list
end


-- ---------- Tìm ORE (chỉ ore: khớp ĐÚNG tên, bỏ Tool / nhân vật / NPC) ----------
local function findOre(name, partial)
	local wanted = trim(name):lower()
	if wanted == "" then return {} end
	local playerChars = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then playerChars[#playerChars + 1] = p.Character end
	end
	local found = {}
	for i, d in ipairs(workspace:GetDescendants()) do
		if i % 4000 == 0 then RunService.Heartbeat:Wait() end
		local dn = (d:IsA("Model") or d:IsA("BasePart")) and d.Name:lower()
		if dn and (dn == wanted or (partial and dn:find(wanted, 1, true))) then
			local bad = d:FindFirstAncestorOfClass("Tool") ~= nil
				or (d:IsA("Model") and d:FindFirstChildOfClass("Humanoid") ~= nil)
			if not bad then
				for _, c in ipairs(playerChars) do
					if d == c or d:IsDescendantOf(c) then bad = true break end
				end
			end
			if not bad then
				local a = d.Parent
				while a and a ~= workspace do
					if a:FindFirstChildOfClass("Humanoid") then bad = true break end
					a = a.Parent
				end
			end
			if not bad then found[d] = true end
		end
	end
	local list = {}
	for inst in pairs(found) do
		local nested, anc = false, inst.Parent
		while anc and anc ~= workspace do
			if found[anc] then nested = true break end
			anc = anc.Parent
		end
		if not nested then list[#list + 1] = inst end
	end
	return list
end

local function tpToOre(name)
	local root = getRoot()
	if not root then return end
	local list = findOre(name)
	local approx = false
	if #list == 0 then list = findOre(name, true) approx = #list > 0 end
	root = getRoot()
	if not root then return end
	local best, bestD, nearest, nearestD
	for _, inst in ipairs(list) do
		local okp, pos = pcall(getPos, inst)
		if okp and pos then
			local d = (pos - root.Position).Magnitude
			if not nearestD or d < nearestD then nearest, nearestD = pos, d end
