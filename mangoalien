local function addNameList(page, placeholder, store, onPick, actions)
	local box, btns = addTextRow(page, placeholder, "", {"+ ADD"})
	local list = makeList(page)
	local render
	local function add()
		local name = trim(box.Text)
		if name == "" then return end
		for _, n in ipairs(store) do
			if n:lower() == name:lower() then box.Text = "" return end
		end
		table.insert(store, name)
		box.Text = ""
		saveConfig()
		render()
	end
	render = function()
		clearList(list)
		if #store == 0 then emptyLabel(list, "List trống") return end
		for i, name in ipairs(store) do
			local acts = {}
			for _, a in ipairs(actions) do
				acts[#acts + 1] = {text = a.text, fn = function() a.fn(name) end}
			end
			addListRow(list, i, name, function() onPick(name) end, acts, function()
				table.remove(store, i)
				saveConfig()
				render()
			end)
		end
	end
	btns[1].MouseButton1Click:Connect(add)
	box.FocusLost:Connect(function(enter) if enter then add() end end)
	render()
	return render
end

