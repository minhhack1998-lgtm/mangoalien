				if t.trk then t.trk.BackgroundColor3 = Theme.Accent end
				if t.st then t.st.Color = Theme.Accent end
			end
		end
	end))
end

local function applyAccent(i)
	accIdx = i
	Config.accent = i
	if i == rainbowIdx then
		RB.start()
		saveConfig()
		return
	end
	RB.stop()
	local a = Accents[i] or Accents[1]
	Theme.Accent, Theme.Accent2 = a[2], a[3]
	for _, e in ipairs(accentProps) do
		if e[1].Parent then e[1][e[2]] = e[3] and Theme.Accent2 or Theme.Accent end
	end
	for _, g in ipairs(accentGrads) do
		if g.Parent then g.Color = ColorSequence.new(Theme.Accent, Theme.Accent2) end
	end
	for _, fn in ipairs(accentHooks) do pcall(fn) end
	saveConfig()
end
