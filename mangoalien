						refreshKeyBtn(oid)
						toast("Đã gỡ " .. kc.Name .. " khỏi: " .. b.name)
					end
				end
				Config.keys[id] = kc.Name
				saveConfig()
			end
			refreshKeyBtn(id)
		end
		return
	end

	if gp then return end

	if input.UserInputType == Enum.UserInputType.Keyboard then
		local name = input.KeyCode.Name
		for id, b in pairs(Binds) do
			if getKey(id) == name then task.spawn(b.action) end
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
		local ctrl = UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)
		if State.clickTP or (State.ctrlTP and ctrl) then teleportToMouse() end
	end
end))

track(LocalPlayer.CharacterAdded:Connect(function()
	if State.fly then Toggles.fly.set(false) end
	if State.ragdoll then Toggles.ragdoll.set(false) end
end))

