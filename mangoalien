local FRight = new("TextLabel", {Size = UDim2.new(0.4, -14, 1, 0), Position = UDim2.new(0.6, 0, 0, 0),
	BackgroundTransparency = 1, Text = "", TextColor3 = Theme.SubText, Font = Enum.Font.GothamBold,
	TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right}, Footer)

do
	local acc, frames = 0, 0
	track(RunService.RenderStepped:Connect(function(dt)
		frames = frames + 1
		acc = acc + dt
		if acc < 0.5 then return end
		local fps = math.floor(frames / acc + 0.5)
		frames, acc = 0, 0
		local ping = 0
		pcall(function()
			ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
		end)
		local n = 0
		for _, t in pairs(Toggles) do
			if not t.opt and State[t.id] then n = n + 1 end
		end
		FLeft.Text = "FPS " .. fps .. "   •   Ping " .. ping .. " ms   •   " .. LocalPlayer.DisplayName
		FRight.Text = (n > 0 and "● " or "○ ") .. n .. " chức năng đang bật"
		FRight.TextColor3 = n > 0 and Theme.Accent or Theme.SubText
	end))
end

