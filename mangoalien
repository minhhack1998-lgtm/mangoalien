local ScanList
local function scanItems()
	clearList(ScanList)
	local folder = workspace:FindFirstChild("Items")
	if not folder then emptyLabel(ScanList, "Không thấy workspace.Items") return {} end
	local counts, names = {}, {}
	for _, it in ipairs(folder:GetChildren()) do
		local n = it.Name
		if not counts[n] then counts[n] = 0 names[#names + 1] = n end
		counts[n] = counts[n] + 1
	end
	table.sort(names, function(a, b) return a:lower() < b:lower() end)
	if #names == 0 then emptyLabel(ScanList, "workspace.Items đang trống") return names end
	for i, n in ipairs(names) do
		local inL = false
		for _, s in ipairs(lootList) do if s:lower() == n:lower() then inL = true break end end
		addListRow(ScanList, i, n .. "  ×" .. counts[n] .. (inL and "  ✓" or ""),
			function() toast(addUnique(lootList, n) and ("Đã thêm: " .. n) or ("Đã có trong list: " .. n)) Fx.renderLoot() scanItems() end,
			{{text = inL and "ĐÃ CÓ" or "ADD", fn = function()
				toast(addUnique(lootList, n) and ("Đã thêm: " .. n) or ("Đã có trong list: " .. n))
				Fx.renderLoot()
				scanItems()
			end}}, nil)
	end
	return names
end
