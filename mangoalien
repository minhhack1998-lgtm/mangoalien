do
local pSell = newTab("SELL", "💰", "Bán")
local Sell = {target = nil, deskCF = nil}
local SellList

local function promptPos(o)
	local p = o.Parent
	if not p then return nil end
	if p:IsA("BasePart") then return p.Position end
	if p:IsA("Attachment") then return p.WorldPosition end
	if p:IsA("Model") then return p:GetPivot().Position end
	local bp = o:FindFirstAncestorWhichIsA("BasePart")
	return bp and bp.Position
end
local function targetPos(t)
	if t:IsA("ProximityPrompt") then return promptPos(t) end
	return t.Parent and t.Parent:IsA("BasePart") and t.Parent.Position or nil
end
local function fireTarget(t)
	if not t or not t.Parent then return false end
	if t:IsA("ProximityPrompt") then
		if fireproximityprompt then
			fireproximityprompt(t)
		else
			t:InputHoldBegin()
			task.wait(math.max(t.HoldDuration, 0) + 0.05)
			t:InputHoldEnd()
		end
		return true
	elseif t:IsA("ClickDetector") and fireclickdetector then
		fireclickdetector(t)
		return true
	end
	return false
end

local function describe(d, dist)
	local what
	if d:IsA("ProximityPrompt") then
		what = "[E] " .. (d.ActionText ~= "" and d.ActionText or "?") .. (d.ObjectText ~= "" and (" / " .. d.ObjectText) or "")
	else
		what = "[Click]"
	end
	local par = d.Parent and d.Parent.Name or "?"
	return what .. "  ·  " .. par .. "  ·  " .. math.floor(dist) .. "m" .. (Sell.target == d and "  ✓" or "")
end

function Sell.scan()
	if not SellList then return end
	clearList(SellList)
	local root = getRoot()
	if not root then return end
	local found = {}
	for i, d in ipairs(workspace:GetDescendants()) do
		if i % 4000 == 0 then RunService.Heartbeat:Wait() end
		if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then
			local pos = targetPos(d)
			if pos then
				local dist = (pos - root.Position).Magnitude
				if dist <= S.sellRange then found[#found + 1] = {inst = d, dist = dist} end
			end
		end
	end
	table.sort(found, function(a, b) return a.dist < b.dist end)
	if #found == 0 then emptyLabel(SellList, "Không thấy nút nào trong bán kính") return end
	for i = 1, math.min(#found, 25) do
		local f = found[i]
		local function choose()
			Sell.target = f.inst
			toast("Đã chọn nút tính tiền: " .. (f.inst.Parent and f.inst.Parent.Name or "?"))
			Sell.scan()
		end
		addListRow(SellList, i, describe(f.inst, f.dist), choose, {
			{text = "FIRE", fn = function()
				local ok = fireTarget(f.inst)
				toast(ok and "Đã kích hoạt thử" or "Executor không hỗ trợ fire")
			end},
			{text = "CHỌN", fn = choose},
		}, nil)
	end
end

function Sell.pull()
	local folder = workspace:FindFirstChild("Items")
	if not folder then return end
	local base = Sell.deskCF and Sell.deskCF.Position or (Sell.target and targetPos(Sell.target))
	if not base then return end
	for _, it in ipairs(folder:GetChildren()) do
		if Loot.wanted(it.Name) then
			local off = Vector3.new(math.random(-20, 20) / 10, 2.5, math.random(-20, 20) / 10)
			if it:IsA("Model") then
				pcall(function() it:PivotTo(CFrame.new(base + off)) end)
			elseif it:IsA("BasePart") then
				pcall(function() it.CFrame = CFrame.new(base + off) end)
			end
		end
	end
end

function Sell.tick()
	local t = Sell.target
	if not t or not t.Parent then return end
	local root = getRoot()
	if not root then return end
	if State.sellPull then Sell.pull() end
	local pos = targetPos(t)
	if State.sellTP and pos then
		local reach = math.min(t.MaxActivationDistance, 10)
		if (root.Position - pos).Magnitude > reach - 1 then
			teleportToCFrame(CFrame.new(pos + Vector3.new(0, 3, 4)))
			task.wait(0.15)
		end
	end
	fireTarget(t)
end

function Sell.remotes()
	local keys = {"sell", "buy", "cash", "shop", "trade", "coin", "money", "pay", "purchase", "register"}
	local n, total = 0, 0
	print("[AlienMango] Remote có tên liên quan tới bán/mua:")
	for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
		if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
			total = total + 1
			local l = d.Name:lower()
			for _, k in ipairs(keys) do
				if l:find(k, 1, true) then
					n = n + 1
					print("   " .. d.ClassName .. "  " .. d:GetFullName())
					break
				end
			end
		end
	end
	toast("Tìm thấy " .. n .. "/" .. total .. " remote liên quan (xem F9)")
end

