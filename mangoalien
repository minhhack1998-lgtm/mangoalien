-- ---------- Tự thoát khi máu thấp / về chỗ chết ----------
local Safe = {cf = nil, last = 0, deathCF = nil}
do
	function Safe.set()
		local r = getRoot()
		if r then Safe.cf = r.CFrame toast("Đã đặt điểm an toàn tại đây") end
	end

	-- Máu thấp hơn ngưỡng (Humanoid hoặc máu tùy chỉnh của game) → TP về điểm an toàn
	function Safe.tick()
		local r = getRoot()
		if not r or not Safe.cf then return end
		local ratio = Hp.ratio()
		if ratio and ratio > 0 and ratio <= S.escapeHp / 100 and os.clock() - Safe.last > 1.5 then
			Safe.last = os.clock()
			teleportToCFrame(Safe.cf)
			if State.escapeOnce then
				toast("Máu thấp → đã về điểm an toàn (1 lần, đã tắt)")
				if Toggles.autoEscape then Toggles.autoEscape.set(false) end
			else
				toast("Máu thấp → về điểm an toàn")
			end
		end
	end

	local function hookChar(c)
		local h = c:WaitForChild("Humanoid", 10)
		if h then
			h.Died:Connect(function()
				local r = c:FindFirstChild("HumanoidRootPart")
				if r then Safe.deathCF = r.CFrame end
			end)
		end
	end
	track(LocalPlayer.CharacterAdded:Connect(function(c)
		task.spawn(hookChar, c)
		if State.respawnBack and Safe.deathCF then
			task.spawn(function()
				local r = c:WaitForChild("HumanoidRootPart", 10)
				if r and Safe.deathCF then
					task.wait(0.6) -- chờ game đặt xong chỗ hồi sinh
					r.CFrame = Safe.deathCF + Vector3.new(0, 3, 0)
					Safe.deathCF = nil
					toast("Về chỗ vừa chết")
				end
			end)
		end
	end))
	if getChar() then task.spawn(hookChar, getChar()) end
end

-- ---------- Kill Aura (đánh NPC trong phạm vi bằng tool đang cầm) ----------
local KA = {set = {}, conn = nil}
do
	local function add(h)
		if h:IsA("Humanoid") then
			local m = h.Parent
			if m and m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then KA.set[h] = true end
		end
	end

	function KA.stop()
		if KA.conn then KA.conn:Disconnect() KA.conn = nil end
		KA.set = {}
	end

	function KA.start()
		KA.stop()
		local conn = workspace.DescendantAdded:Connect(add)
		KA.conn = conn
		task.spawn(function()
			for i, d in ipairs(workspace:GetDescendants()) do
				if KA.conn ~= conn then return end
				add(d)
				if i % 3000 == 0 then RunService.Heartbeat:Wait() end
			end
		end)
	end

	function KA.tick()
		local root, hum = getRoot(), getHum()
		if not root or not hum or hum.Health <= 0 then return end
		local tool = equipTool()
		local handle = tool and tool:FindFirstChild("Handle")
		local hits, nearest, nd = 0, nil, nil
		for h in pairs(KA.set) do
			local m = h.Parent
			if not m then
				KA.set[h] = nil
			elseif h.Health > 0 then
				local part = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildWhichIsA("BasePart")
				if part then
					local d = (part.Position - root.Position).Magnitude
					if d <= S.kaRange then
						if not nd or d < nd then nearest, nd = part, d end
						if State.kaTouch and handle and handle:IsA("BasePart") and firetouchinterest then
							pcall(function()
								firetouchinterest(handle, part, 0)
								firetouchinterest(handle, part, 1)
							end)
						end
						hits = hits + 1
						if hits >= 8 then break end
					end
				end
			end
		end
		if hits > 0 and nearest then
			if State.kaFace then
				local np = nearest.Position
				local flat = Vector3.new(np.X, root.Position.Y, np.Z)
				if (flat - root.Position).Magnitude > 0.1 then root.CFrame = CFrame.lookAt(root.Position, flat) end
			end
			if tool then pcall(function() tool:Activate() end) end
		end
	end
end

