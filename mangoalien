			pcall(function()
				h:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
				h.MaxHealth = 100
				h.Health = 100
			end)
		end
		local ff = c and c:FindFirstChild("AM_FF")
		if ff then ff:Destroy() end
	end
end

-- ---------- Tự thoát khi máu thấp / về chỗ chết ----------
local Safe = {cf = nil, last = 0, deathCF = nil}
do
	function Safe.set()
		local r = getRoot()
		if r then Safe.cf = r.CFrame toast("Đã đặt điểm an toàn tại đây") end
	end

	function Safe.tick()
		local r = getRoot()
		if not r or not Safe.cf then return end
		local ratio = Hp.ratio()
		if ratio and ratio > 0 and ratio <= S.escapeHp / 100 and os.clock() - Safe.last > 1.5 then
			Safe.last = os.clock()
			teleportToCFrame(Safe.cf, true)
			if State.escapeOnce then
				toast("Máu thấp → đã về điểm an toàn (1 lần, đã tắt)")
				if Toggles.autoEscape then Toggles.autoEscape.set(false) end
			else
				toast("Máu thấp → về điểm an toàn")
			end
		end
	end

	local function hookChar(c)
		local h = c:WaitForChild("Humanoid", 10)
		if h then
			h.Died:Connect(function()
				local r = c:FindFirstChild("HumanoidRootPart")
				if r then Safe.deathCF = r.CFrame end
			end)
		end
	end
	track(LocalPlayer.CharacterAdded:Connect(function(c)
		task.spawn(hookChar, c)
		if State.respawnBack and Safe.deathCF then
			task.spawn(function()
				local r = c:WaitForChild("HumanoidRootPart", 10)
				if r and Safe.deathCF then
					task.wait(0.6)
					r.CFrame = Safe.deathCF + Vector3.new(0, 3, 0)
					Safe.deathCF = nil
					toast("Về chỗ vừa chết")
				end
			end)
		end
	end))
	if getChar() then task.spawn(hookChar, getChar()) end
end

