-- =========================================================
-- GUI+: TÌM KIẾM • THU GỌN MỤC • CHẤM TRẠNG THÁI • KÉO GIÃN CỬA SỔ
-- =========================================================
local Grip
do
	local function uiScale() return (MainScale and MainScale.Scale) or 1 end

	-- trang kết quả tìm kiếm (ẩn khỏi thanh bên)
	local pSearch = newTab("SEARCH", "🔍", "Kết quả tìm kiếm")
	tabBtns.SEARCH.Visible = false
	UX.rev = {}
	for n, pg in pairs(pages) do UX.rev[pg] = n end

	-- thu gọn / mở rộng từng mục (nhớ trạng thái)
	UX.groupOf = {}
	local allGroups = {}
	for pname, page in pairs(pages) do
		if pname ~= "SEARCH" then
			local kids = {}
			for _, c in ipairs(page:GetChildren()) do
				if c:IsA("GuiObject") then kids[#kids + 1] = c end
			end
			table.sort(kids, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
			local grp
			for _, c in ipairs(kids) do
				local sec = c:GetAttribute("sec")
				if sec then
					local g = {items = {}, open = true, key = pname .. "/" .. sec}
					local arrow = new("TextLabel", {Size = UDim2.new(0, 22, 1, 0), Position = UDim2.new(1, -24, 0, 0),
						BackgroundColor3 = Theme.Bg, BackgroundTransparency = 0, Text = "▾", TextColor3 = Theme.SubText,
						Font = Enum.Font.GothamBold, TextSize = 12, ZIndex = 3}, c)
					local btn = new("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "",
						ZIndex = 4, AutoButtonColor = false}, c)
					g.set = function(open, nosave)
						g.open = open
						arrow.Text = open and "▾" or "▸"
						for _, it in ipairs(g.items) do it.Visible = open end
						if not nosave then
							Config.collapsed[g.key] = (not open) or nil
							saveConfig()
						end
					end
					btn.MouseButton1Click:Connect(function() g.set(not g.open) end)
					btn.MouseEnter:Connect(function() tween(arrow, {TextColor3 = Theme.Text}) end)
					btn.MouseLeave:Connect(function() tween(arrow, {TextColor3 = Theme.SubText}) end)
					grp = g
					allGroups[#allGroups + 1] = g
				elseif grp then
					grp.items[#grp.items + 1] = c
					UX.groupOf[c] = grp
				end
			end
		end
	end
	for _, g in ipairs(allGroups) do
		if Config.collapsed[g.key] then g.set(false, true) end
	end

	-- ô tìm kiếm trên thanh tiêu đề
	local box = new("TextBox", {
		Size = UDim2.new(1, -(222 + 88), 0, 26), Position = UDim2.new(0, 222, 0.5, -13),
		BackgroundColor3 = Theme.Input, PlaceholderText = "🔍  Tìm chức năng...", PlaceholderColor3 = Theme.SubText,
		Text = "", TextColor3 = Theme.Text, Font = Enum.Font.Gotham, TextSize = 12, ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, Header)
	corner(box, 8)
	new("UIPadding", {PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 8)}, box)
	local bst = stroke(box, Theme.Accent, 1, 1)
	bindAccent(bst, "Color")
	box.Focused:Connect(function() tween(bst, {Transparency = 0.2}) end)
	box.FocusLost:Connect(function() tween(bst, {Transparency = 1}) end)
	UX.box = box

	function UX.jump(e, tab)
		UX.jumping = true
		box.Text = ""
		UX.jumping = false
		switchTab(tab)
		local g = UX.groupOf[e.row]
		if g and not g.open then g.set(true) end
		task.delay(0.25, function()
			local pg, row = pages[tab], e.row
			if not (pg and row and row.Parent) then return end
			local y = (row.AbsolutePosition.Y - pg.AbsolutePosition.Y) / uiScale() + pg.CanvasPosition.Y - 6
			pg.CanvasPosition = Vector2.new(0, math.max(y, 0))
			tween(row, {BackgroundColor3 = Theme.Item:Lerp(Theme.Accent, 0.45)}, 0.15)
			task.delay(0.9, function()
				if row.Parent then tween(row, {BackgroundColor3 = Theme.Item}, 0.3) end
			end)
		end)
	end

	function UX.runSearch(q)
		for _, c in ipairs(pSearch:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		q = trim(q):lower()
		local n = 0
		for _, e in ipairs(UX.reg) do
			local tab = UX.rev[e.page]
			if tab and tab ~= "SEARCH" and e.row and e.row.Parent then
				local tag = UX.tabLabel[tab] or tab
				if (e.label .. " " .. tag):lower():find(q, 1, true) then
					n = n + 1
					if n > 40 then break end
					local isT = (e.kind == "toggle")
					local rightW = isT and 54 or 8
					local row = card(pSearch, 38, n)
					hover(row, Theme.Item, Theme.ItemHover)
					local icon = isT and "◉" or (e.kind == "slider" and "≡" or "▶")
					new("TextLabel", {Size = UDim2.new(1, -(rightW + 16), 0, 18), Position = UDim2.new(0, 12, 0, 4),
						BackgroundTransparency = 1, Text = icon .. "  " .. e.label, TextColor3 = Theme.Text,
						Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd}, row)
					new("TextLabel", {Size = UDim2.new(1, -(rightW + 16), 0, 12), Position = UDim2.new(0, 12, 0, 22),
						BackgroundTransparency = 1, Text = "trong " .. tag, TextColor3 = Theme.SubText,
						Font = Enum.Font.Gotham, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left}, row)
					local pick = new("TextButton", {Size = UDim2.new(1, -(rightW + 4), 1, 0), BackgroundTransparency = 1,
						Text = "", AutoButtonColor = false}, row)
					pick.MouseButton1Click:Connect(function() UX.jump(e, tab) end)
					if isT then
						local t = Toggles[e.id]
						local b = new("TextButton", {Size = UDim2.new(0, 44, 0, 22), Position = UDim2.new(1, -50, 0.5, -11),
							BackgroundColor3 = State[e.id] and Theme.Accent or Theme.Off, Text = State[e.id] and "BẬT" or "TẮT",
							TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 10, AutoButtonColor = false}, row)
						corner(b, 6)
						b.MouseButton1Click:Connect(function()
							t.toggle()
							b.Text = State[e.id] and "BẬT" or "TẮT"
							tween(b, {BackgroundColor3 = State[e.id] and Theme.Accent or Theme.Off}, 0.15)
						end)
					end
				end
			end
		end
		if n == 0 then emptyLabel(pSearch, "Không có chức năng nào khớp \"" .. q .. "\"") end
	end

	box:GetPropertyChangedSignal("Text"):Connect(function()
		if UX.jumping then return end
		local q = trim(box.Text)
		if q == "" then
			if activeTab == "SEARCH" then switchTab(UX.prevTab or "HOME") end
		else
			if activeTab ~= "SEARCH" then UX.prevTab = activeTab end
			UX.runSearch(q)
			if activeTab ~= "SEARCH" then switchTab("SEARCH") end
		end
	end)

	-- chấm sáng trên thanh bên: tab nào đang có chức năng bật
	UX.dotOn = {}
	function UX.updateDots()
		local on = {}
		for id, t in pairs(Toggles) do
			if not t.opt and State[id] and t.page then
				local tab = UX.rev[t.page]
				if tab then on[tab] = true end
			end
		end
		for name, dot in pairs(UX.dots) do
			local v = on[name] and true or false
			if UX.dotOn[name] ~= v then
				UX.dotOn[name] = v
				tween(dot, {BackgroundTransparency = v and 0 or 1}, 0.2)
			end
		end
	end
	UX.updateDots()

	-- tay nắm kéo giãn cửa sổ (góc dưới phải)
	Grip = new("TextButton", {Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(1, -22, 1, -22),
		BackgroundTransparency = 1, Text = "◢", TextColor3 = Theme.SubText, TextSize = 14,
		Font = Enum.Font.GothamBold, ZIndex = 60, AutoButtonColor = false}, Main)
	hover(Grip, Theme.SubText, Theme.Text, "TextColor3")
	local rs, rStart, w0, h0 = false, nil, W, H
	Grip.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			rs, rStart, w0, h0 = true, i.Position, W, H
		end
	end)
	track(UIS.InputChanged:Connect(function(i)
		if rs and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - rStart
			local sc = uiScale()
			W = math.clamp(math.floor(w0 + d.X / sc), 520, 1100)
			H = math.clamp(math.floor(h0 + d.Y / sc), 340, 760)
			Main.Size = UDim2.new(0, W, 0, H)
		end
	end))
	track(UIS.InputEnded:Connect(function(i)
		if rs and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
			rs = false
			Config.winW, Config.winH = W, H
			saveConfig()
		end
	end))
end

local minimized = false
MinBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	Side.Visible = not minimized
	Content.Visible = not minimized
	Footer.Visible = not minimized
	if Grip then Grip.Visible = not minimized end
	tween(Main, {Size = UDim2.new(0, W, 0, minimized and HEAD or H)}, 0.25)
end)

unload = function()
	for _, t in pairs(Toggles) do
		if not t.persist and State[t.id] then pcall(t.set, false) end
	end
	if afkConn then afkConn:Disconnect() afkConn = nil end
	pcall(Lag.restore)
	pcall(VF.stop)
	Loops = {}
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	conns = {}
	flushConfig()
	genv.AlienMango_Unload = nil
	pcall(function()
		tween(Main, {Size = UDim2.new(0, W, 0, 0)}, 0.2)
		task.wait(0.2)
		ScreenGui:Destroy()
	end)
end
genv.AlienMango_Unload = unload
CloseBtn.MouseButton1Click:Connect(function() unload() end)

