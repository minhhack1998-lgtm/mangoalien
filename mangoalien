-- ================= TABS =================
local pages, tabBtns, tabInd, tabNames, tabOrder, activeTab = {}, {}, {}, {}, 0, nil
UX = {reg = {}, tabLabel = {}, dots = {}, search = ""}

local function refreshTabs()
	for n, btn in pairs(tabBtns) do
		local on = (n == activeTab)
		btn.BackgroundColor3 = Theme.Accent
		tween(btn, {BackgroundTransparency = on and 0.78 or 1}, 0.15)
		btn.TextColor3 = on and Color3.new(1, 1, 1) or Theme.SubText
		tween(tabInd[n], {BackgroundTransparency = on and 0 or 1}, 0.15)
	end
end
accentHooks[#accentHooks + 1] = refreshTabs

local function switchTab(name)
	local prev = activeTab
	activeTab = name
	if name ~= "SEARCH" then
		Config.tab = name
		saveConfig()
		if UX.box and UX.box.Text ~= "" then
			UX.jumping = true
			UX.box.Text = ""
			UX.jumping = false
		end
	end
	if name == "HOME" and UX.homeRefresh then UX.homeRefresh() end
	for n, p in pairs(pages) do p.Visible = (n == name) end
	PageTitle.Text = tabNames[name] or name
	if prev ~= name and pages[name] then
		pages[name].Position = UDim2.new(0, 14, 0, PAGE_TOP)
		tween(pages[name], {Position = UDim2.new(0, 0, 0, PAGE_TOP)}, 0.18)
	end
	refreshTabs()
end

