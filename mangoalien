-- ================= UI HELPERS =================
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function tween(obj, props, t)
	TweenService:Create(obj, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end
local function corner(obj, r) return new("UICorner", {CornerRadius = UDim.new(0, r or 8)}, obj) end
local function stroke(obj, color, th, tr)
	return new("UIStroke", {Color = color, Thickness = th or 1, Transparency = tr or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, obj)
end
local function hover(obj, normal, over, prop)
	prop = prop or "BackgroundColor3"
	obj.MouseEnter:Connect(function() tween(obj, {[prop] = over}) end)
	obj.MouseLeave:Connect(function() tween(obj, {[prop] = normal}) end)
end

