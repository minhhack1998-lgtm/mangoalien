-- ---------- Thêm tên vật dưới con trỏ vào list ----------
local IgnoreNames = {
	Part = true, Baseplate = true, Terrain = true, Handle = true, SpawnLocation = true, Camera = true,
	HumanoidRootPart = true, Head = true, Torso = true, UpperTorso = true, LowerTorso = true, Model = true,
	Folder = true, Wedge = true, MeshPart = true, Union = true, Workspace = true,
}
local function addUnique(store, name)
	for _, n in ipairs(store) do
		if n:lower() == name:lower() then return false end
	end
	table.insert(store, name)
	saveConfig()
	return true
end

function Fx.pickUnderMouse(store, render)
	local t = Mouse.Target
	if not t then toast("Không có vật nào dưới con trỏ") return end
	local n = t.Name
	-- vật nằm trong workspace.Items → lấy tên con trực tiếp của Items
	local items = workspace:FindFirstChild("Items")
	if items and t:IsDescendantOf(items) then
		local a = t
		while a.Parent and a.Parent ~= items do a = a.Parent end
		n = a.Name
	end
	if IgnoreNames[n] then
		local m = t:FindFirstAncestorOfClass("Model")
		if m and not Players:GetPlayerFromCharacter(m) then n = m.Name end
	end
	if IgnoreNames[n] then toast("Tên quá chung chung: " .. n) return end
	toast(addUnique(store, n) and ("Đã thêm: " .. n) or ("Đã có trong list: " .. n))
	if render then render() end
end

-- ---------- ESP tên item (nhãn gọn, không chồng nhau, có số mét) ----------
-- Tối ưu chống lag: mặc định chỉ đọc workspace.Items (rất nhẹ). Chế độ toàn map dùng cache + quét chia nhỏ từng khung hình.
local ESP = {gui = nil, map = {}, items = {}, rconn = nil, on = false, filter = "",
	cache = {}, adn = setmetatable({}, {__mode = "k"}), queue = {}, qi = 1, conns = {}, lastTxt = 0}
do
	local SkipESP = {Terrain = true, Baseplate = true, SpawnLocation = true, Camera = true}
	local modelOk = setmetatable({}, {__mode = "k"})

	local function inPlayer(inst)
		for _, p in ipairs(Players:GetPlayers()) do
			local c = p.Character
			if c and (inst == c or inst:IsDescendantOf(c)) then return true end
		end
		return false
	end
	local function underHumanoid(inst)
		local a = inst.Parent
		while a and a ~= workspace do
			if a:FindFirstChildOfClass("Humanoid") then return true end
			a = a.Parent
		end
		return false
	end
	local function cand(d)
		if d:IsA("Tool") then return d end
		if not d:IsA("BasePart") or underHumanoid(d) then return nil end
		local tool = d:FindFirstAncestorOfClass("Tool")
		if tool then return tool end
		local m = d:FindFirstAncestorOfClass("Model")
		if m then
			local ok = modelOk[m]
			if ok == nil then
				ok = #m:GetDescendants() <= 300
				modelOk[m] = ok
			end
			if ok then return m end
		end
		return d
	end
	local function adornee(inst)
		if inst:IsA("Model") then return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true) end
		if inst:IsA("Tool") then return inst:FindFirstChild("Handle") or inst:FindFirstChildWhichIsA("BasePart", true) end
		return inst
	end
	local function adn(c)
		local a = ESP.adn[c]
		if not a or not a.Parent then
			a = adornee(c)
			ESP.adn[c] = a
		end
		return a
	end
	local function esc(t) return (t:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end

	local function inList(store, n)
		local l = n:lower()
		for _, s in ipairs(store) do
			local w = s:lower()
			if l == w or l:find(w, 1, true) then return true end
		end
		return false
	end

	local function makeLabel()
		local l = Instance.new("TextLabel")
		l.AnchorPoint = Vector2.new(0.5, 1)
		l.AutomaticSize = Enum.AutomaticSize.XY
		l.Size = UDim2.new(0, 0, 0, 0)
		l.BackgroundColor3 = Color3.fromRGB(12, 12, 20)
		l.BackgroundTransparency = 0.2
		l.BorderSizePixel = 0
		l.RichText = true
		l.Font = Enum.Font.GothamMedium
		l.TextSize = S.espSize
		l.TextColor3 = Color3.new(1, 1, 1)
		l.TextXAlignment = Enum.TextXAlignment.Center
		l.Visible = false
		l.Text = ""
		local c = Instance.new("UICorner") c.CornerRadius = UDim.new(0, 6) c.Parent = l
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 8), UDim.new(0, 8)
		pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 3), UDim.new(0, 3)
		pad.Parent = l
		local st = Instance.new("UIStroke")
		st.Color, st.Thickness, st.Transparency = Color3.fromRGB(255, 226, 110), 1, 0.35
		st.Parent = l
		l.Parent = ESP.gui
		return l
	end

	local function fmt(it, d)
		local col = d < 30 and "#7CFC9A" or (d < 100 and "#8FE3FF" or "#C9CCE0")
		local nm = esc(it.name)
		if it.count > 1 then nm = nm .. "  ×" .. it.count end
		local sub = (it.parent and (esc(it.parent) .. "  ·  ") or "") .. d .. " m"
		return '<font color="#FFE27A"><b>' .. nm .. '</b></font>\n<font color="' .. col .. '" size="' .. math.max(S.espSize - 1, 8) .. '"><b>' .. sub .. '</b></font>'
	end

	-- chế độ toàn map: xử lý hàng đợi theo lát 3ms/khung hình, không bao giờ làm đơ game
	local function pump()
		local q, i = ESP.queue, ESP.qi
		local n = #q
		if i > n then
			if n > 0 then ESP.queue, ESP.qi = {}, 1 end
			return
		end
		local t0, cnt = os.clock(), 0
		while i <= n do
			local d = q[i]
			q[i] = false
			i = i + 1
			if d and d.Parent and (d:IsA("BasePart") or d:IsA("Tool")) and not d:IsA("Terrain") then
				local c = cand(d)
				if c and not ESP.cache[c] and not inPlayer(c) then ESP.cache[c] = true end
			end
			cnt = cnt + 1
			if cnt % 40 == 0 and os.clock() - t0 > 0.003 then break end
		end
		ESP.qi = i
	end
	function ESP.watchStart()
		if ESP.conns.add then return end
		ESP.queue, ESP.qi, ESP.cache = workspace:GetDescendants(), 1, {}
		ESP.conns.add = track(workspace.DescendantAdded:Connect(function(d) ESP.queue[#ESP.queue + 1] = d end))
		ESP.conns.rem = track(workspace.DescendantRemoving:Connect(function(d) ESP.cache[d] = nil end))
		ESP.conns.pump = track(RunService.Heartbeat:Connect(pump))
	end
	function ESP.watchStop()
		for k, c in pairs(ESP.conns) do
			c:Disconnect()
			ESP.conns[k] = nil
		end
		ESP.cache, ESP.queue, ESP.qi = {}, {}, 1
	end

	function ESP.clear()
		if ESP.rconn then ESP.rconn:Disconnect() ESP.rconn = nil end
		if ESP.gui then pcall(function() ESP.gui:Destroy() end) end
		ESP.gui, ESP.map, ESP.items = nil, {}, {}
	end

	function ESP.refresh()
		local root = getRoot()
		if not root or not ESP.on then return end
		local filter = trim(ESP.filter):lower()
		local mode = S.espMode
		local rp, range = root.Position, S.espRange
		local r2 = range * range
		local folder = (S.espSrc ~= 2) and workspace:FindFirstChild("Items") or nil
		if folder then
			if next(ESP.conns) then ESP.watchStop() end
		else
			ESP.watchStart()
		end

		local list, n = {}, 0
		local function consider(c)
			local name = c.Name
			if SkipESP[name] then return end
			if filter ~= "" and not name:lower():find(filter, 1, true) then return end
			if mode == 2 and not inList(lootList, name) then return end
			local a = adn(c)
			if not a then return end
			local p = a.Position
			local dx, dy, dz = p.X - rp.X, p.Y - rp.Y, p.Z - rp.Z
			local d2 = dx * dx + dy * dy + dz * dz
			if d2 <= r2 then
				n = n + 1
				list[n] = {inst = c, ad = a, pos = p, d2 = d2, name = name}
			end
		end
		if folder then
			for _, c in ipairs(folder:GetChildren()) do
				if c:IsA("Model") or c:IsA("BasePart") or c:IsA("Tool") then consider(c) end
			end
		else
			for c in pairs(ESP.cache) do
				if c.Parent then consider(c) else ESP.cache[c] = nil end
			end
		end
		if not ESP.on then return end
		table.sort(list, function(a, b) return a.d2 < b.d2 end)

		-- gộp vật cùng tên nằm trong 6 studs → "Tên ×N" (chỉ so với cụm cùng tên nên rất nhẹ)
		local clusters, byName, nc, maxN = {}, {}, 0, S.espMax
		for _, e in ipairs(list) do
			local p, name = e.pos, e.name
			local same = byName[name]
			local merged = false
			if same then
				for _, c in ipairs(same) do
					local dx, dy, dz = p.X - c.px, p.Y - c.py, p.Z - c.pz
					if dx * dx + dy * dy + dz * dz <= 36 then
						c.count = c.count + 1
						merged = true
						break
					end
				end
			end
			if not merged and nc < maxN then
				nc = nc + 1
				local c = {inst = e.inst, ad = e.ad, name = name, count = 1, px = p.X, py = p.Y, pz = p.Z}
				clusters[nc] = c
				if not same then same = {} byName[name] = same end
				same[#same + 1] = c
			end
		end

		if not ESP.gui then
			local g = Instance.new("ScreenGui")
			g.Name, g.ResetOnSpawn, g.IgnoreGuiInset, g.DisplayOrder = "AM_ESP", false, true, 998
			g.Parent = ScreenGui.Parent
			ESP.gui = g
		end
		local keep, items = {}, {}
		for _, c in ipairs(clusters) do
			local it = ESP.map[c.inst]
			if not it then
				it = {inst = c.inst, label = makeLabel()}
				ESP.map[c.inst] = it
			end
			if it.count ~= c.count or it.name ~= c.name then it.lastD = nil end
			it.ad, it.name, it.count = c.ad, c.name, c.count
			local inst = c.inst
			local par = inst.Parent
			it.parent = (not inst:IsA("Model") and not inst:IsA("Tool") and par and par ~= workspace and par.Name ~= "Items")
				and par.Name or nil
			keep[c.inst] = true
			items[#items + 1] = it
		end
		for inst, it in pairs(ESP.map) do
			if not keep[inst] then
				it.label:Destroy()
				ESP.map[inst] = nil
			end
		end
		ESP.items = items
	end

	function ESP.render()
		local items = ESP.items
		if #items == 0 then return end
		local cam, root = workspace.CurrentCamera, getRoot()
		if not cam or not root then return end
		local rp = root.Position
		local now = os.clock()
		local doText = now - ESP.lastTxt > 0.15
		if doText then ESP.lastTxt = now end
		local size = S.espSize
		local up = Vector3.new(0, 2, 0)
		local placed, np = {}, 0
		for _, it in ipairs(items) do
			local ad, lb = it.ad, it.label
			if not ad or not ad.Parent or not lb.Parent then
				lb.Visible = false
			else
				local pos = ad.Position
				local v, on = cam:WorldToViewportPoint(pos + up)
				if not on or v.Z <= 0 then
					lb.Visible = false
				else
					local d = math.floor((pos - rp).Magnitude)
					local setNow = false
					if it.lastD == nil or (doText and it.lastD ~= d) or it.size ~= size then
						it.lastD, it.size = d, size
						lb.TextSize = size
						lb.Text = fmt(it, d)
						it.needSize, setNow = true, true
					end
					if it.needSize and not setNow then
						local w0, h0 = lb.AbsoluteSize.X, lb.AbsoluteSize.Y
						if w0 >= 20 then it.w, it.h = w0, h0 end
						it.needSize = false
					end
					local w, h = it.w or 100, it.h or 34
					local x, y = v.X, v.Y
					for _ = 1, 8 do
						local hit = false
						for k = 1, np do
							local r = placed[k]
							if math.abs(x - r[1]) < (w + r[3]) / 2 + 2 and math.abs(y - r[2]) < (h + r[4]) / 2 + 2 then
								y = y - (h + 3)
								hit = true
								break
							end
						end
						if not hit then break end
					end
					np = np + 1
					placed[np] = {x, y - h / 2, w, h}
					lb.Position = UDim2.fromOffset(x, y)
					lb.Visible = true
				end
			end
		end
	end

	function ESP.start()
		ESP.on = true
		if ESP.rconn then ESP.rconn:Disconnect() end
		ESP.rconn = track(RunService.RenderStepped:Connect(ESP.render))
		startLoop("esp", ESP.refresh, function() return 0.75 end)
	end
	function ESP.stop()
		ESP.on = false
		stopLoop("esp")
		ESP.watchStop()
		ESP.clear()
	end
end

-- ---------- Đọc máu (Humanoid + máu tùy chỉnh của game: Attribute / NumberValue) ----------
local Hp = {name = (type(Config.hpName) == "string") and Config.hpName or "", peak = 0,
	cur = nil, max = nil, scanAt = 0, label = ""}
do
	local function isHpName(n)
		n = n:lower()
		if n:find("max", 1, true) or n:find("regen", 1, true) or n:find("rate", 1, true)
			or n:find("damage", 1, true) then return false end
		if n:find("health", 1, true) then return true end
		local sp = " " .. n:gsub("[^a-z]", " ") .. " "
		return sp:find(" hp ", 1, true) ~= nil or n:find("curhp", 1, true) ~= nil
			or n:find("currenthp", 1, true) ~= nil
	end
	local function isMaxName(n)
		n = n:lower()
		if not n:find("max", 1, true) then return false end
		return n:find("health", 1, true) ~= nil or n:find("hp", 1, true) ~= nil
	end

	local function sources()
		local out = {}
		for _, holder in ipairs({getChar(), LocalPlayer}) do
			if holder then
				for k, v in pairs(holder:GetAttributes()) do
					if type(v) == "number" then
						out[#out + 1] = {name = k, where = "Attribute",
							get = function() return holder:GetAttribute(k) end,
							set = function(x) holder:SetAttribute(k, x) end}
					end
				end
				for _, d in ipairs(holder:GetDescendants()) do
					if d:IsA("NumberValue") or d:IsA("IntValue") then
						out[#out + 1] = {name = d.Name, where = "Value",
							get = function() return d.Value end,
							set = function(x) d.Value = x end}
					end
					if #out > 400 then break end
				end
			end
		end
		return out
	end

	function Hp.scan()
		Hp.cur, Hp.max, Hp.label = nil, nil, ""
		local want = trim(Hp.name):lower()
		for _, src in ipairs(sources()) do
			local n = src.name:lower()
			if not Hp.cur and ((want ~= "" and n == want) or (want == "" and isHpName(src.name))) then Hp.cur = src end
			if not Hp.max and isMaxName(src.name) then Hp.max = src end
		end
		if Hp.cur then Hp.label = Hp.cur.where .. " " .. Hp.cur.name end
		Hp.scanAt = os.clock()
	end

	function Hp.read()
		if not Hp.cur and os.clock() - Hp.scanAt > 2 then Hp.scan() end
		if not Hp.cur then return nil end
		local ok, cur = pcall(Hp.cur.get)
		if not ok or type(cur) ~= "number" then Hp.cur = nil return nil end
		local mx
		if Hp.max then
			local okm, m = pcall(Hp.max.get)
			if okm and type(m) == "number" then mx = m end
		end
		if cur > Hp.peak then Hp.peak = cur end
		return cur, mx or Hp.peak
	end

	function Hp.ratio()
		local best
		local h = getHum()
		if h and h.Health > 0 and h.MaxHealth > 0 and h.MaxHealth < 1e8 then best = h.Health / h.MaxHealth end
		local cur, mx = Hp.read()
		if cur and mx and mx > 0 then
			local r = cur / mx
			if not best or r < best then best = r end
		end
		return best
	end

	function Hp.report()
		Hp.scan()
		local cur, mx = Hp.read()
		local h = getHum()
		print("[AlienMango] Các giá trị số tìm thấy (Character + Player):")
		for _, src in ipairs(sources()) do
			local okv, v = pcall(src.get)
			print("   " .. src.where .. "  " .. src.name .. " = " .. tostring(okv and v or "?"))
		end
		if cur then
			toast("Máu: " .. Hp.label .. " = " .. math.floor(cur) .. "/" .. math.floor(mx or 0))
		else
			toast("Không thấy máu tuỳ chỉnh • Humanoid " .. (h and (math.floor(h.Health) .. "/" .. math.floor(h.MaxHealth)) or "?")
				.. "  (xem F9)")
		end
	end

	track(LocalPlayer.CharacterAdded:Connect(function() Hp.cur, Hp.max, Hp.peak, Hp.scanAt = nil, nil, 0, 0 end))
end

-- ---------- God mode ----------
local God = {conn = nil}
do
	function God.apply()
		local h, c = getHum(), getChar()
		if not h then return end
		pcall(function()
			h.MaxHealth = math.huge
			h.Health = math.huge
			h:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		end)
		if c and not c:FindFirstChild("AM_FF") then
			pcall(function()
				local ff = Instance.new("ForceField")
				ff.Name, ff.Visible, ff.Parent = "AM_FF", false, c
			end)
		end
	end
	function God.start()
		God.stop(true)
		God.apply()
		God.conn = RunService.Heartbeat:Connect(function()
			local h, c = getHum(), getChar()
			if not h then return end
			local cur, mx = Hp.read()
			if cur and mx and cur < mx then pcall(Hp.cur.set, mx) end
			if h.MaxHealth ~= math.huge or not (c and c:FindFirstChild("AM_FF")) then
				God.apply()
			elseif h.Health < h.MaxHealth then
				h.Health = h.MaxHealth
			end
		end)
	end
	function God.stop(quiet)
		if God.conn then God.conn:Disconnect() God.conn = nil end
		if quiet then return end
		local h, c = getHum(), getChar()
