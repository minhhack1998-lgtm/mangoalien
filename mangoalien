		TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = tabOrder * 10 + 5}, Side)
end

local function newTab(name, icon, label)
	tabOrder = tabOrder + 1
	local btn = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Theme.Accent, BackgroundTransparency = 1,
		Text = "  " .. icon .. "  " .. label, TextColor3 = Theme.SubText, Font = Enum.Font.GothamBold,
		TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, LayoutOrder = tabOrder * 10,
	}, Side)
	corner(btn, 8)
	local ind = new("Frame", {Size = UDim2.new(0, 3, 0, 16), Position = UDim2.new(0, 2, 0.5, -8),
		BorderSizePixel = 0, BackgroundTransparency = 1}, btn)
	corner(ind, 2)
	bindAccent(ind, "BackgroundColor3")
	btn.MouseEnter:Connect(function() if activeTab ~= name then tween(btn, {BackgroundTransparency = 0.9}, 0.12) end end)
	btn.MouseLeave:Connect(function() if activeTab ~= name then tween(btn, {BackgroundTransparency = 1}, 0.12) end end)
	btn.MouseButton1Click:Connect(function() switchTab(name) end)
	tabBtns[name] = btn
	tabInd[name] = ind

	local page = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Visible = false,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}, Content)
	bindAccent(page, "ScrollBarImageColor3")
	new("UIPadding", {PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 8)}, page)
	new("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, page)
	pages[name] = page
	return page
end

-- ================= KEYBIND SYSTEM =================
local Binds, listening = {}, nil
local KeyShort = {
	LeftControl = "LCtrl", RightControl = "RCtrl", LeftShift = "LShift", RightShift = "RShift",
	LeftAlt = "LAlt", RightAlt = "RAlt", Return = "Enter", Backquote = "`", Minus = "-", Equals = "=",
	LeftBracket = "[", RightBracket = "]", Semicolon = ";", Quote = "'", Comma = ",", Period = ".",
	Slash = "/", BackSlash = "\\", Insert = "Ins", Delete = "Del", PageUp = "PgUp", PageDown = "PgDn",
	Zero = "0", One = "1", Two = "2", Three = "3", Four = "4", Five = "5", Six = "6", Seven = "7",
	Eight = "8", Nine = "9",
}

local function getKey(id)
	local k = Config.keys[id]
	if k == nil then k = Binds[id].default end
	if k == false then return nil end
	return k
end

local function refreshKeyBtn(id)
	local b = Binds[id]
	if not b or not b.btn then return end
	if listening == id then
		b.btn.Text = "..."
		b.btn.TextColor3 = Theme.Accent
	else
		local k = getKey(id)
		b.btn.Text = k and (KeyShort[k] or k) or "—"
		b.btn.TextColor3 = k and Theme.Text or Theme.SubText
	end
end
accentHooks[#accentHooks + 1] = function() for id in pairs(Binds) do refreshKeyBtn(id) end end

local function makeKeyBtn(parent, id)
	local b = new("TextButton", {
		Size = UDim2.new(0, 58, 0, 24), Position = UDim2.new(1, -64, 0.5, -12), BackgroundColor3 = Theme.Input,
		Text = "", Font = Enum.Font.GothamBold, TextSize = 11, AutoButtonColor = false,
	}, parent)
	corner(b, 7)
	bindAccent(stroke(b, Theme.Accent, 1, 0.55), "Color")
	Binds[id].btn = b
	b.MouseButton1Click:Connect(function()
		local prev = listening
		listening = (listening == id) and nil or id
		if prev then refreshKeyBtn(prev) end
		refreshKeyBtn(id)
		if listening then toast("Nhấn phím mới  (Esc huỷ • Backspace = bỏ phím)") end
	end)
	refreshKeyBtn(id)
	return b
end

