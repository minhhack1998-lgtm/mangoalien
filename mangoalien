-- ---------- Auto aim ----------
local AimParts = {"Head", "HumanoidRootPart"}
local npcList, npcConn, aimConn = {}, nil, nil
local function addNPC(h)
	if h:IsA("Humanoid") then
		local m = h.Parent
		if m and m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then npcList[h] = true end
	end
end
local function visibleTo(origin, part, model)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = {getChar()}
	rp.IgnoreWater = true
	local res = workspace:Raycast(origin, part.Position - origin, rp)
	return (not res) or res.Instance:IsDescendantOf(model)
end
local function stopAim()
	if aimConn then aimConn:Disconnect() aimConn = nil end
	if npcConn then npcConn:Disconnect() npcConn = nil end
	npcList = {}
end
local function startAim()
	stopAim()
	for _, d in ipairs(workspace:GetDescendants()) do addNPC(d) end
	npcConn = workspace.DescendantAdded:Connect(addNPC)
	aimConn = RunService.RenderStepped:Connect(function()
		local cam, root = workspace.CurrentCamera, getRoot()
		if not cam or not root then return end
		local center = cam.ViewportSize / 2
		local me = getChar()
		local pname = AimParts[S.aimPartIdx] or "Head"
		local best, bestScore
		for h in pairs(npcList) do
			local m = h.Parent
			if not m then
				npcList[h] = nil
			elseif h.Health > 0 and m ~= me then
				local part = m:FindFirstChild(pname) or m:FindFirstChild("HumanoidRootPart")
				if part and (part.Position - root.Position).Magnitude <= S.aimRange then
					local p, on = cam:WorldToViewportPoint(part.Position)
					if on then
						local score = (Vector2.new(p.X, p.Y) - center).Magnitude
						if score <= S.aimFov and (not best or score < bestScore)
							and (not State.aimWall or visibleTo(cam.CFrame.Position, part, m)) then
							best, bestScore = part, score
						end
					end
				end
			end
		end
		if best then
			local goal = CFrame.new(cam.CFrame.Position, best.Position)
			cam.CFrame = (S.aimSmooth >= 1) and goal or cam.CFrame:Lerp(goal, S.aimSmooth)
		end
	end)
end

