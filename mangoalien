do
local function others()
	local out = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then out[#out + 1] = p end
	end
	table.sort(out, function(a, b) return a.Name:lower() < b.Name:lower() end)
	return out
end
local function tpPlayer(p)
	local r = p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not r then toast("Không thấy nhân vật của " .. (p and p.Name or "?")) return end
	teleportToCFrame(r.CFrame * CFrame.new(0, 0, 4))
	toast("TP tới: " .. p.DisplayName)
end
local function findByName(q)
	q = trim(q):lower()
	if q == "" then return nil end
	local partial
	for _, p in ipairs(others()) do
		local n, d = p.Name:lower(), p.DisplayName:lower()
		if n == q or d == q then return p end
		if not partial and (n:find(q, 1, true) or d:find(q, 1, true)) then partial = p end
	end
	return partial
end
local nextIdx = 0
local function tpNext()
	local list = others()
	if #list == 0 then toast("Server không có ai khác") return end
	nextIdx = nextIdx % #list + 1
	tpPlayer(list[nextIdx])
end
local function tpNear()
	local root = getRoot()
	if not root then return end
	local best, bd
	for _, p in ipairs(others()) do
		local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if r then
			local d = (r.Position - root.Position).Magnitude
			if not bd or d < bd then best, bd = p, d end
		end
	end
	if best then tpPlayer(best) else toast("Không có ai trong server") end
end

