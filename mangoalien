-- =========================================================
track(UIS.InputBegan:Connect(function(input, gp)
	-- Đang chờ gán phím mới
	if listening then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			local id, kc = listening, input.KeyCode
			listening = nil
			if kc == Enum.KeyCode.Escape then
				-- huỷ
			elseif kc == Enum.KeyCode.Backspace or kc == Enum.KeyCode.Delete then
				Config.keys[id] = false
				saveConfig()
			else
				for oid, b in pairs(Binds) do
					if oid ~= id and getKey(oid) == kc.Name then
						Config.keys[oid] = false
						refreshKeyBtn(oid)
						toast("Đã gỡ " .. kc.Name .. " khỏi: " .. b.name)
					end
				end
				Config.keys[id] = kc.Name
				saveConfig()
			end
			refreshKeyBtn(id)
		end
		return
	end

	if gp then return end

	if input.UserInputType == Enum.UserInputType.Keyboard then
		local name = input.KeyCode.Name
		for id, b in pairs(Binds) do
			if getKey(id) == name then task.spawn(b.action) end
		end
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
		local ctrl = UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)
		if State.clickTP or (State.ctrlTP and ctrl) then teleportToMouse() end
	end
end))

