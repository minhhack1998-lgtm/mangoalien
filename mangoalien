-- ---------- Bring / TP item ----------
local bringBusy = false
local function bringItems(name, silent)
	name = name or bringName
	local root = getRoot()
	if not root or bringBusy then return 0 end
	bringBusy = true
	local okS, list = pcall(searchItems, name)
	bringBusy = false
	if not okS then return 0 end

	root = getRoot()
	if not root then return 0 end
	local count = 0
	for _, inst in ipairs(list) do
		if inst.Parent then
			local offset = CFrame.new((count % 5 - 2) * 3, 0, -5 - math.floor(count / 5) * 3)
			local target = root.CFrame * offset
			local ok = pcall(function()
				if inst:IsA("Model") then
					inst:PivotTo(target)
				elseif inst:IsA("Tool") then
					local h = inst:FindFirstChild("Handle")
					if h then h.AssemblyLinearVelocity = Vector3.zero h.CFrame = target end
				else
					inst.AssemblyLinearVelocity = Vector3.zero
					inst.CFrame = target
				end
			end)
			if ok then count = count + 1 end
		end
	end
	if not silent then
		toast(count > 0 and ("Bring " .. count .. ": " .. name) or ("Không thấy: " .. name))
	end
	return count
end

