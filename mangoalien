-- ---------- TIỆN ÍCH MỚI 2: farm bám NPC • tự hồi máu • tuần tra • vòng FOV ----------
do
	Fx.t0 = os.clock()

	-- AUTO FARM NPC: bay bám sau lưng NPC gần nhất (kết hợp Auto Attack / Auto Aim)
	local AF = {npc = {}, conn = nil, hook = nil, target = nil, home = nil}
	Fx.AF = AF
	local function hookN(h)
		if h:IsA("Humanoid") then
			local m = h.Parent
			if m and m:IsA("Model") and not Players:GetPlayerFromCharacter(m) then AF.npc[m] = h end
		end
	end
	local function rootOf(m) return m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart end
	local function pick(root)
		local q = trim(Fx.afFilter or ""):lower()
		local best, bd
		for m, h in pairs(AF.npc) do
			if not m.Parent then
				AF.npc[m] = nil
			elseif h.Health > 0 and (q == "" or m.Name:lower():find(q, 1, true)) then
				local r = rootOf(m)
				if r then
					local d = (r.Position - root.Position).Magnitude
					if d <= S.afRange and (not bd or d < bd) then best, bd = m, d end
				end
			end
		end
		return best
	end
	function AF.stop(quiet)
		if AF.conn then AF.conn:Disconnect() AF.conn = nil end
		if AF.hook then AF.hook:Disconnect() AF.hook = nil end
		AF.npc, AF.target = {}, nil
		if not quiet and State.afReturn and AF.home then teleportToCFrame(AF.home, true) end
		AF.home = nil
	end
	function AF.start()
		AF.stop(true)
		local root = getRoot()
		AF.home = root and root.CFrame
		AF.hook = track(workspace.DescendantAdded:Connect(hookN))
		for i, d in ipairs(workspace:GetDescendants()) do
			if i % 3000 == 0 then
				RunService.Heartbeat:Wait()
				if not State.autoFarm then return end
			end
			hookN(d)
		end
		if not State.autoFarm then return end
		AF.conn = track(RunService.Heartbeat:Connect(function()
			local r = getRoot()
			if not r then return end
			local t = AF.target
			local th = t and AF.npc[t]
			if not (t and t.Parent and th and th.Health > 0) then
				t = pick(r)
				AF.target = t
			end
			local tr = t and rootOf(t)
			if tr then
				local pos = tr.Position - tr.CFrame.LookVector * S.afDist + Vector3.new(0, S.afHeight, 0)
				r.AssemblyLinearVelocity = Vector3.zero
				r.CFrame = CFrame.new(pos, tr.Position)
			end
		end))
	end

	-- AUTO HEAL: dùng item (Tool) hồi máu khi máu thấp
	local AH = {last = 0, used = 0}
	Fx.AH = AH
	function AH.tick()
		local q = trim(Fx.healName or ""):lower()
		if q == "" then return end
		local ratio = Hp.ratio()
		if not ratio or ratio <= 0 or ratio > S.healHp / 100 then return end
		if os.clock() - AH.last < S.healCd then return end
		local char, hum = getChar(), getHum()
		if not char or not hum then return end
		local function match(t) return t:IsA("Tool") and t.Name:lower():find(q, 1, true) ~= nil end
		local tool
		for _, c in ipairs(char:GetChildren()) do
			if match(c) then tool = c break end
		end
		if not tool then
			local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
			if bp then
				for _, c in ipairs(bp:GetChildren()) do
					if match(c) then tool = c break end
				end
			end
			if tool then
				pcall(function() hum:EquipTool(tool) end)
				task.wait(0.1)
			end
		end
		if tool then
			AH.last = os.clock()
			AH.used = AH.used + 1
			pcall(function() tool:Activate() end)
		end
	end

	-- TUẦN TRA: lần lượt đi qua các điểm đã lưu
	local PT = {i = 0}
	Fx.PT = PT
	function PT.step()
		if #points == 0 then return end
		PT.i = PT.i % #points + 1
		local cf = pointCF(points[PT.i])
		if S.patrolMode == 2 then
			Fx.walkTo(cf.Position)
			local t0 = os.clock()
			while State.patrol and os.clock() - t0 < 60 do
				local r = getRoot()
				if r and (r.Position - cf.Position).Magnitude < 6 then break end
				task.wait(0.25)
			end
		else
			teleportToCFrame(cf)
		end
		local t1 = os.clock()
		while State.patrol and os.clock() - t1 < S.patrolWait do task.wait(0.1) end
	end

	-- VÒNG FOV của Auto Aim hiện trên màn hình
	local FC = {}
	Fx.FC = FC
	function FC.sync()
