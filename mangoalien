local RB = {}
function RB.seq(h)
	local pts = {}
	for k = 0, 6 do
		pts[#pts + 1] = ColorSequenceKeypoint.new(k / 6, Color3.fromHSV((h + k / 6) % 1, 0.8, 1))
	end
	return ColorSequence.new(pts)
end

function RB.stop()
	if RB.conn then RB.conn:Disconnect() RB.conn = nil end
	mainGrad.Rotation = 45
end
function RB.start()
	if RB.conn then RB.conn:Disconnect() end
	local frame = 0
	RB.conn = track(RunService.RenderStepped:Connect(function()
		frame = frame + 1
		local h = (os.clock() * 0.12) % 1
		Theme.Accent = Color3.fromHSV(h, 0.75, 1)
		Theme.Accent2 = Color3.fromHSV((h + 0.18) % 1, 0.75, 1)
		if frame % 300 == 0 then
			local j = 0
			for i = 1, #accentProps do
				local e = accentProps[i]
				if e[1].Parent then j = j + 1 accentProps[j] = e end
			end
			for i = j + 1, #accentProps do accentProps[i] = nil end
		end
		for _, e in ipairs(accentProps) do
			if e[1].Parent then e[1][e[2]] = e[3] and Theme.Accent2 or Theme.Accent end
		end
		local seq = ColorSequence.new(Theme.Accent, Theme.Accent2)
		for _, g in ipairs(accentGrads) do
			if g.Parent then g.Color = seq end
		end
		local rb = RB.seq(h)
		mainGrad.Color = rb
		titleGrad.Color = rb
		mainGrad.Rotation = (os.clock() * 50) % 360
		for _, b in pairs(tabBtns) do b.BackgroundColor3 = Theme.Accent end
		for _, t in pairs(Toggles) do
			if State[t.id] then
				if t.trk then t.trk.BackgroundColor3 = Theme.Accent end
				if t.st then t.st.Color = Theme.Accent end
			end
		end
	end))
end

local function applyAccent(i)
	accIdx = i
	Config.accent = i
	if i == rainbowIdx then
		RB.start()
		saveConfig()
		return
	end
	RB.stop()
	local a = Accents[i] or Accents[1]
	Theme.Accent, Theme.Accent2 = a[2], a[3]
	for _, e in ipairs(accentProps) do
		if e[1].Parent then e[1][e[2]] = e[3] and Theme.Accent2 or Theme.Accent end
	end
	for _, g in ipairs(accentGrads) do
		if g.Parent then g.Color = ColorSequence.new(Theme.Accent, Theme.Accent2) end
	end
	for _, fn in ipairs(accentHooks) do pcall(fn) end
	saveConfig()
end
